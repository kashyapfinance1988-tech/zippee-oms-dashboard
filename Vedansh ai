<script id="backlog-safe-fix">
/* BUG FIX: Dispatch Backlog ke functions (blBuild, blRender, blCopy, blCsv) file mein defined nahi the.
   Filter/Copy/CSV click par ReferenceError aata tha. Ye basic safe versions hain. */
(function(){
  function esc(x){ return String(x==null?'':x).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
  function rowsOf(others){
    var out=[];
    if(!others) return out;
    Object.keys(others).forEach(function(k){
      var arr=others[k];
      if(Array.isArray(arr)) arr.forEach(function(r){ out.push({hub:k,row:r}); });
    });
    return out;
  }
  window.blBuild=function(others,date){
    window.__blRows=rowsOf(others);
    window.__blDate=date||'';
    window.blRender();
  };
  window.blRender=function(){
    var rows=window.__blRows||[];
    var cnt=document.getElementById('blCount');
    if(cnt) cnt.textContent=rows.length;
    var hubSel=document.getElementById('blHub');
    var body=document.getElementById('blHubBody');
    if(hubSel && hubSel.options.length<=1){
      var hubs=[];
      rows.forEach(function(x){ if(hubs.indexOf(x.hub)<0) hubs.push(x.hub); });
      hubs.forEach(function(h){ var o=document.createElement('option'); o.value=h; o.textContent=h; hubSel.appendChild(o); });
    }
    var hf=hubSel?hubSel.value:'';
    var per={};
    rows.forEach(function(x){
      if(hf && x.hub!==hf) return;
      per[x.hub]=(per[x.hub]||0)+1;
    });
    if(body){
      var h='';
      Object.keys(per).forEach(function(k){
        h+='<tr><td>'+esc(k)+'</td><td>'+per[k]+'</td><td>-</td><td>-</td><td>-</td><td>-</td><td>-</td></tr>';
      });
      body.innerHTML=h||'<tr><td colspan="7" style="text-align:center;color:#64748b">Backlog data nahi hai — pehle CSV upload karein</td></tr>';
    }
  };
  window.blCopy=function(){
    var rows=window.__blRows||[];
    var txt='Dispatch Backlog ('+(window.__blDate||'')+'): '+rows.length+' orders';
    if(navigator.clipboard) navigator.clipboard.writeText(txt).then(function(){alert('Copied:\n'+txt);},function(){alert(txt);});
    else alert(txt);
  };
  window.blCsv=function(){
    var rows=window.__blRows||[];
    var lines=['Hub,Row'];
    rows.forEach(function(x){ lines.push('"'+String(x.hub).replace(/"/g,'""')+'","'+String(JSON.stringify(x.row)).replace(/"/g,'""')+'"'); });
    var blob=new Blob([lines.join('\n')],{type:'text/csv;charset=utf-8'});
    var a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download='dispatch_backlog.csv';
    document.body.appendChild(a); a.click(); a.remove();
  };
})();
</script>

