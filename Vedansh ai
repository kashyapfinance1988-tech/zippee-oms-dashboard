<script id="tab-fullpng-js">
(function(){
  var H2C_URL='https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
  function loadH2C(cb){
    if(window.html2canvas) return cb(null);
    var sc=document.createElement('script'); sc.src=H2C_URL;
    sc.onload=function(){cb(null)}; sc.onerror=function(){cb(new Error('html2canvas load nahi hua — internet check karein'))};
    document.head.appendChild(sc);
  }
  window.downloadTabPNG=function(tabId){
    var el=document.getElementById(tabId);
    if(!el){ alert('Tab nahi mila: '+tabId); return; }
    var wasActive=el.classList.contains('active');
    if(!wasActive){ try{ window.showTab && window.showTab(tabId, null); }catch(e){} }
    loadH2C(function(err){
      if(err){ alert(err.message); return; }
      requestAnimationFrame(function(){ setTimeout(function(){
        window.html2canvas(el,{
          scale:2, backgroundColor:'#eef2f7', useCORS:true, logging:false,
          windowWidth:el.scrollWidth, windowHeight:el.scrollHeight,
          scrollX:0, scrollY:-window.scrollY,
          ignoreElements:function(n){ return n.classList && n.classList.contains('png-bar'); }
        }).then(function(cv){
          cv.toBlob(function(bl){
            if(!bl){ alert('PNG nahi ban paya'); return; }
            var d=new Date(), pad=function(n){return ('0'+n).slice(-2)};
            var name='Zippee_'+tabId+'_'+d.getFullYear()+pad(d.getMonth()+1)+pad(d.getDate())+'_'+pad(d.getHours())+pad(d.getMinutes())+'.png';
            var a=document.createElement('a'); a.href=URL.createObjectURL(bl); a.download=name;
            document.body.appendChild(a); a.click(); setTimeout(function(){URL.revokeObjectURL(a.href); a.remove();},1000);
          },'image/png');
        }).catch(function(e){ alert('PNG error: '+(e&&e.message||e)); });
      },150)});
    });
  };
})();
</script>

<script id="sheet-sync-js">
(function(){
  var KEY='zippee.sheetUrl.v1';
  window.setSheetUrl=function(){
    var cur=localStorage.getItem(KEY)||'';
    var u=prompt('Apps Script Web App URL paste karein (https://script.google.com/macros/s/.../exec):',cur);
    if(u===null) return;
    u=u.trim();
    if(u && !/^https:\/\/script\.google\.com\//.test(u)){ alert('Ye valid Apps Script URL nahi lag raha.'); return; }
    if(u) localStorage.setItem(KEY,u); else localStorage.removeItem(KEY);
    alert(u?'URL save ho gaya.':'URL hata diya gaya.');
  };
  function dateKey(){
    var d=window.__dataDate || (typeof todayStr==='function'?todayStr():'');
    if(!d){ var t=new Date(); d=t.toISOString().slice(0,10); }
    return String(d).slice(0,10);
  }
  window.saveDayToSheet=async function(){
    var url=localStorage.getItem(KEY);
    if(!url){ setSheetUrl(); url=localStorage.getItem(KEY); if(!url) return; }
    var list=(typeof hubDataList!=='undefined'&&Array.isArray(hubDataList))?hubDataList:[];
    var rows=list.filter(function(h){return h && h.store}).map(function(h){
      return {city:h.city||'', hub:h.store, planned:h.planned||0, actual:h.actual||0,
              plannedOrders:h.plannedOrders||0, orders:null};
    });
    if(!rows.length){ alert('Abhi koi hub data nahi hai. Pehle CSV upload karein.'); return; }
    var body={date:dateKey(), source:'dashboard', rows:rows};
    try{
      var res=await fetch(url,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(body)});
      var out=await res.json();
      if(out.ok) alert('✅ Sheet mein save ho gaya: '+out.written+' hub rows ('+body.date+')');
      else alert('❌ Save fail: '+(out.error||'unknown'));
    }catch(e){
      alert('❌ Sheet tak pahunch nahi paayi: '+e.message+'\nURL aur deployment (Anyone access) check karein.');
    }
  };
})();
</script>
