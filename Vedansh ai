  if(d==null||isNaN(d))return '<span class="v3-dim">—</span>';
  if(Math.abs(d)<0.5)return '<span class="v3-dim">→</span>';
  const good=inv?d<0:d>0;
  return '<span class="'+(good?'v3-up':'v3-dn')+'">'+(d>0?'▲':'▼')+Math.abs(d).toFixed(0)+(suf||'')+'</span>';
}
function pctChip(p){const c=p>=75?'v3-g':(p>=40?'v3-y':'v3-r');return '<span class="v3-chip '+c+'">'+fx(p,1)+'%</span>';}
