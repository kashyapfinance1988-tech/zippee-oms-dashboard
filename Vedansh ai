function _validateAndDedupeRaw(inputRows) {
  if (!inputRows || !inputRows.length) throw new Error('CSV empty hai.');
  const width = inputRows[0].length;
  const headers = inputRows[0].map(function(x) { return String(x || '').trim(); });
  if (!headers.some(Boolean)) throw new Error('CSV header row khali hai.');
  const norm = function(x) { return String(x || '').toLowerCase().replace(/[^a-z0-9]/g, ''); };
  const hn = headers.map(norm);
  const idIndex = hn.findIndex(function(h) { return ['zippeeawb','zippeeawbnumber','awb','awbid','awbno','awbnum','awbnumber','waybill','waybillno','waybillnumber','trackingid','trackingnumber','shipmentid','shipmentno','shipmentnumber','orderid','orderno','ordernumber','orderkey','orderreference'].includes(h); });
  const clean = [inputRows[0]];
  const seen = new Map();
  let malformed = 0, exactDuplicates = 0, duplicateIds = 0;
  for (let i = 1; i < inputRows.length; i++) {
    const r = inputRows[i];
    if (!r || !r.some(function(v) { return String(v || '').trim() !== ''; })) continue;
    if (r.length !== width) { malformed++; continue; }
    const sig = JSON.stringify(r);
    if (idIndex >= 0) {
      const id = String(r[idIndex] || '').trim().toLowerCase();
      if (id) {
        if (seen.has(id)) {
          const pos = seen.get(id);
          if (JSON.stringify(clean[pos]) === sig) exactDuplicates++;
          else duplicateIds++;
          // Keep the last occurrence of an order ID, which is generally the latest OMS state.
          clean[pos] = r;
          continue;
        }
        seen.set(id, clean.length);
      }
    } else if (seen.has(sig)) { exactDuplicates++; continue; }
    if (idIndex < 0) seen.set(sig, clean.length);
    clean.push(r);
  }
  if (malformed) throw new Error(malformed + ' row(s) mein columns ki count header se match nahi karti. CSV correct karke dobara upload karein.');
  if (clean.length < 2) throw new Error('CSV mein valid data rows nahi hain.');
  return { rows: clean, exactDuplicates: exactDuplicates, duplicateIds: duplicateIds };
}


