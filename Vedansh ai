        {h:'S.No',w:7},{h:'Hub / Store',w:22,align:'left'},{h:'Rider Name',w:22,align:'left'},
        {h:'Rider ID',w:14},{h:'Orders',w:10},{h:'Delivered',w:10},{h:'Del %',w:10},
        {h:'First Seen',w:14},{h:'Status',w:12}
      ];
      // pad/truncate rows to cols
      rows = rows.map(function(r){
        var out=[];
        for(var k=0;k<cols.length;k++) out.push(r[k]!=null?r[k]:'');
        return out;
      });
      var day = (window.__dataDate||new Date().toISOString().slice(0,10));
      var cv = window._drawReport({
        title:'New Riders Report — Zippee',
        sub:'Data Date: '+day+' · Generated: '+new Date().toLocaleString('en-IN'),
        cols:cols,
        rows:rows,
        footer: window.PNG_FOOTER || 'Powered by Vedansh | Zippee Last Mile'
      });
      window._save(cv, 'New_Riders_'+String(day).replace(/[^\d-]/g,'')+'.png');
      var sm=document.getElementById('statusMsg');
      if(sm) sm.textContent='✅ New Riders PNG download start';
    }catch(e){
      console.error(e);
      alert('New Riders PNG error: '+e.message);
    }
  };
  // Point New Riders PNG bar button to this
  document.addEventListener('DOMContentLoaded', function(){
    document.querySelectorAll('[data-for="newRidersTab"] button').forEach(function(btn){
      if(/Riders PNG/i.test(btn.textContent||'')){
        btn.setAttribute('onclick',"downloadNewRidersPNG()");
      }
    });
  });
})();
</script>


<script id="png-safe-guard">
(function(){
  function needData(name){
    var has = !!(window.__dataDate || window.__statusAgg || (window.hubs && Object.keys(window.hubs||{}).length));
    if(!has){
      var sm=document.getElementById('statusMsg');
      if(sm) sm.textContent='❌ Pehle CSV upload karein — phir '+name+' PNG niklega';
      alert('Pehle Detailed CSV upload karein.\nUske baad '+name+' PNG available hoga.');
      return false;
    }
    return true;
  }
  function wrap(fnName){
    var orig=window[fnName];
    if(typeof orig!=='function' || orig.__safePng) return;
    window[fnName]=function(){
      if(!needData(fnName)) return;
      try{ return orig.apply(this,arguments); }
      catch(e){ console.error(fnName,e); alert(fnName+' error: '+e.message); }
    };
    window[fnName].__safePng=true;
  }
  function run(){
    ['downloadHubPNG','downloadActivePNG','downloadTataCanterPNG','downloadOnTimeBreachPNG','downloadClosurePNG',
     'downloadFunnelPNG','downloadBriefingPNG','downloadStatusPNG','downloadClinReportPNG'].forEach(wrap);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',run);
  else run();
  setTimeout(run,1000);
})();
</script>


