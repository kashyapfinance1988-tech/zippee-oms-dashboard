          if (newRidersList.length + '|' + riderRegistryNote !== before) {
            renderNewRiders();
            try { if (typeof window.ctSaveNow === 'function') window.ctSaveNow(); } catch (e) {}
          }
        }).catch(function() {});
      }

      // Force official planned + plan orders after CSV (localStorage purana na badle)
      if (typeof seedPlanned === 'function') { /* already ran as IIFE */ }
      (function(){
        const OFFICIAL_PLAN = {
          'okhlasdd':20,'okhla':20,'janakpuri':7,'wazirpur':13,'wazirpursdd':13,
          'gurgaon':7,'gurugram':7,
