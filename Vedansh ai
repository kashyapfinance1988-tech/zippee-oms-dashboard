function backfillHistFromOthers(others) {
  try {
    const h = loadMap(HIST_KEY); let changed = false;
    const plan = hubDataList.reduce(function(a, x) { return a + (Number(x.planned) || 0); }, 0);
    Object.keys(others || {}).forEach(function(day) {
