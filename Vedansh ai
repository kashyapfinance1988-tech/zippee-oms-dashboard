      })();

      // A prior Shiway date/filter must never override Delivered counts for this new CSV.
      window.__sasaDelTot = null;
      window.__kpiTotalOrders = null;
      window.__zippeeCsvLoaded = true;
      dataSource = 'csv';
      renderAll();
      backfillHistFromOthers(split.others);
