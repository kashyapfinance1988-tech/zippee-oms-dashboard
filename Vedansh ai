function dayKeys(){return Array.from(new Set(Object.keys(loadMap(HIST_KEY)).concat(Object.keys(loadMap(H2))))).sort();}
function dayData(d){
  const a=loadMap(HIST_KEY)[d]||null,b=loadMap(H2)[d]||null;
  const tot=a?{ord:a.orders!=null?a.orders:null,del:a.delivered!=null?a.delivered:null,pl:a.planned!=null?a.planned:null,ac:a.actual!=null?a.actual:null}:null;
  if(!tot&&b){const t={ord:0,del:0,pl:0,ac:0},seenOrd=[],seenDel=[];Object.keys(b.hubs||{}).forEach(k=>{const x=b.hubs[k];if(x.ord!=null)seenOrd.push(Number(x.ord)||0);if(x.del!=null)seenDel.push(Number(x.del)||0);t.pl+=Number(x.planned)||0;t.ac+=Number(x.actual)||0;});t.ord=seenOrd.length?seenOrd.reduce((a,x)=>a+x,0):null;t.del=seenDel.length?seenDel.reduce((a,x)=>a+x,0):null;return {tot:t,hubs:b.hubs};}
  const hubs={};
  if(a&&a.hubs)Object.keys(a.hubs).forEach(k=>{hubs[k]=Object.assign({},a.hubs[k]);});
  if(b&&b.hubs)Object.keys(b.hubs).forEach(k=>{hubs[k]=Object.assign(hubs[k]||{},b.hubs[k]);});
  return {tot:tot,hubs:hubs};
}
