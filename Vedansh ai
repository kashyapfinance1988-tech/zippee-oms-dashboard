          'ozinoida62':0,'ozinoidasec1':0,'ozidwarkasector3':0,'ozigurugramsec84':0,'ozigurugramsec52':0,'ozimalviyanagar':0,'clinikallygurugramsec29':88
        };
        hubDataList.forEach(function(h){
          const k = hubKey(h.store);
          // Planned riders are user-managed; preserve saved/manual values across CSV uploads.
          Object.keys(OFFICIAL_ORDERS).forEach(function(pk){
            if (k === pk || k.indexOf(pk) >= 0 || pk.indexOf(k) >= 0) h.plannedOrders = OFFICIAL_ORDERS[pk];
          });
