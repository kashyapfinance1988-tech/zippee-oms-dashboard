function parseCSV(t){
 t=String(t||'').replace(/^﻿/,'');var out=[],row=[],v='',q=false,i,c;
 for(i=0;i<t.length;i++){c=t[i];
  if(q){if(c==='"'){if(t[i+1]==='"'){v+='"';i++}else q=false}else v+=c}
  else if(c==='"')q=true;
  else if(c===','){row.push(v);v=''}
  else if(c==='\n'||c==='\r'){if(c==='\r'&&t[i+1]==='\n')i++;row.push(v);v='';if(row.length>1||row[0]!=='')out.push(row);row=[]}
  else v+=c}
 if(v!==''||row.length){row.push(v);out.push(row)}
 return out}
var norm=function(h){return String(h||'').replace(/^﻿/,'').toLowerCase().replace(/[^a-z0-9]/g,'')};
