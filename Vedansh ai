function downloadOnTimeBreachPNG() {
  try { renderHubSummary(); } catch (e) {}
  const pct = function(a,b){ return b > 0 ? (a/b*100).toFixed(1)+'%' : '—'; };
  // Build OT/Breach for ALL hubs from full CSV (not just Tata)
  const otMap = {};
  function parseCsvDt(dateStr, timeStr) {
    dateStr = String(dateStr||'').trim(); timeStr = String(timeStr||'').trim();
    if (!dateStr) return null;
    if (!timeStr) {
      var combined = dateStr.match(/^(.+?)\s+(\d{1,2}:\d{2}(?::\d{2})?)\s*$/);
      if (combined) { dateStr = combined[1].trim(); timeStr = combined[2].trim(); }
    }
    var d=null, mth=null, y=null, hh=0, mm=0, ss=0, x;
    if ((x = dateStr.match(/(\d{1,2})[\/\-\.](\d{1,2})[\/\-\.](\d{4})/))) { d=+x[1]; mth=+x[2]; y=+x[3]; }
    else if ((x = dateStr.match(/(\d{4})[\/\-\.](\d{1,2})[\/\-\.](\d{1,2})/))) { y=+x[1]; mth=+x[2]; d=+x[3]; }
    if (!y || !mth || !d) return null;
    if (timeStr) {
      var t = timeStr.match(/(\d{1,2}):(\d{2})(?::(\d{2}))?/);
      if (t) { hh=+t[1]; mm=+t[2]; ss=+(t[3]||0); }
    }
    var dt = new Date(y, mth-1, d, hh, mm, ss);
    return isNaN(dt.getTime()) ? null : dt;
  }
  function hubCanon(wh) {
    var s = String(wh||'').toLowerCase();
    if (/1mg/.test(s) && /rohtas/.test(s)) return 'ZD 1MG Rohtas Nagar';
    if (/1mg/.test(s) && /dwarka/.test(s)) return 'ZD 1MG Dwarka';
    if (/1mg/.test(s) && /malad/.test(s)) return 'ZD 1MG Malad';
    if (/ghaziabad|dilshad|gitab|gita\s*b/.test(s)) return 'Ghaziabad SDD (Dilshad Garden)';
    if (/okhla/.test(s)) return 'Okhla SDD';
    if (/janakpuri|dwarka/.test(s) && /sdd|zipp/.test(s)) return 'Dwarka SDD (Janakpuri)';
    if (/wazir/.test(s)) return 'Wazirpur SDD';
    if (/noida/.test(s) && /sdd|zipp/.test(s)) return 'Noida SDD';
    if (/gurugram|gurgaon/.test(s) && /clinik|clk/.test(s)) return 'Clinikally Gurugram';
    if (/gurugram|gurgaon/.test(s)) return 'Gurugram SDD';
    if (/faridabad/.test(s)) return 'Faridabad SDD';
    return String(wh||'').trim() || 'Other';
  }
  try {
    var csvText = window.__fullCsvText || '';
    if (csvText && typeof parseCSV === 'function') {
      var parsed = parseCSV(csvText);
      if (parsed && parsed.length > 1) {
        var hdrs = parsed[0].map(function(h){ return String(h||'').replace(/^\uFEFF/,'').toLowerCase().replace(/[^a-z0-9]/g,''); });
        function idx(){ for(var a=0;a<arguments.length;a++){ var i=hdrs.indexOf(arguments[a]); if(i>=0) return i; } return -1; }
        var iWh = idx('warehousename','warehouse','hubstore','storename','store');
        var iSt = idx('currentstatus','status','orderstatus');
        var iCanc = idx('iscancelled','cancelled','iscancel');
        var iIdeal = idx('idealdeliveryend');
        if (iIdeal < 0) iIdeal = hdrs.findIndex(function(h){ return h.indexOf('ideal')>=0 && h.indexOf('end')>=0; });
        var iOid = idx('orderid','orderno','ordernumber','order','orderidnumber');
        var __seenOrd = {};
        var iActD = idx('actualdeliverydate');
        var iActT = idx('actualdeliverytime');
        var iDelD = idx('delivereddate');
        var iDelT = idx('deliveredtime');
        var asOf = new Date();
        try {
          var dd = (window.__dataDate || '').split('-');
          if (dd.length === 3) asOf = new Date(+dd[0], +dd[1]-1, +dd[2] + 1, 7, 0, 0);
        } catch(eAs) {}
        for (var ri = 1; ri < parsed.length; ri++) {
          var row = parsed[ri];
          var wh = iWh >= 0 ? String(row[iWh]||'') : '';
          if (!wh) continue;
          var k = hubCanon(wh);
          if (!otMap[k]) otMap[k] = {onTime:0, late:0, open:0, delivered:0, d0:0, orders:0, cancelled:0};
          // one row per order: skip repeated status-history rows
          var __oid = iOid >= 0 ? String(row[iOid] || '').trim() : '';
          if (__oid) { var __sk = k + '|' + __oid; if (__seenOrd[__sk]) continue; __seenOrd[__sk] = 1; }
          otMap[k].orders++;
          var st = String(iSt>=0 ? row[iSt] : '').toUpperCase().replace(/[ .\-]+/g,'_');
          var canc = String(iCanc>=0 ? row[iCanc] : '').toLowerCase() === 'true' || /CANCEL/.test(st);
          if (canc) { otMap[k].cancelled++; continue; }
          var ideal = iIdeal >= 0 ? parseCsvDt(row[iIdeal], '') : null;
          var act = null;
          if (iActD >= 0) act = parseCsvDt(row[iActD], iActT>=0 ? row[iActT] : '');
          if (!act && iDelD >= 0) act = parseCsvDt(row[iDelD], iDelT>=0 ? row[iDelT] : '');
          var isDel = (st === 'DELIVERED') || !!act;
          var isReady = (st === 'READY');
          if (!isReady) otMap[k].d0++;
          if (isDel) {
            otMap[k].delivered++;
            if (ideal && act) {
              if (act.getTime() <= ideal.getTime()) otMap[k].onTime++;
              else otMap[k].late++;
            } else {
              // delivered but no timestamp: not provably on-time -> count as untimed, not on-time
              otMap[k].untimed = (otMap[k].untimed||0) + 1;
            }
          } else {
            if (ideal && ideal.getTime() < asOf.getTime()) otMap[k].open++;
          }
        }
      }
    }
  } catch (eOt) { console.warn('OnTimeBreach calc', eOt); }

  var keys = Object.keys(otMap).filter(function(k){ return otMap[k].d0 > 0 || otMap[k].delivered > 0; });
  // Sort: SDD first, then Tata, then others; within group by orders desc
  keys.sort(function(a,b){
    function rank(n){
      if (/okhla/i.test(n)) return 1;
      if (/dwarka|janakpuri/i.test(n) && !/1mg/i.test(n)) return 2;
      if (/wazir/i.test(n)) return 3;
      if (/gurugram|gurgaon/i.test(n) && !/clinik/i.test(n)) return 4;
      if (/noida/i.test(n) && !/1mg/i.test(n)) return 5;
      if (/ghaziabad|dilshad|gitab/i.test(n)) return 6;
      if (/faridabad/i.test(n)) return 7;
      if (/clinik/i.test(n)) return 8;
      if (/1mg|tata/i.test(n)) return 9;
      return 10;
    }
    var ra = rank(a), rb = rank(b);
    if (ra !== rb) return ra - rb;
    return (otMap[b].orders||0) - (otMap[a].orders||0);
  });
  if (!keys.length) {
    alert('On-Time / Breach data nahi mila. Pehle Detailed CSV upload karein.');
    return;
  }

  var rows = [];
  var T = {d0:0, del:0, onTime:0, late:0, open:0};
  keys.forEach(function(k, i){
    var m = otMap[k];
    var d0 = m.d0, del = m.delivered, on = m.onTime, late = m.late, open = m.open;
    T.d0 += d0; T.del += del; T.onTime += on; T.late += late; T.open += open;
    var breach = late + open;
    rows.push([
      i+1, k, d0, del, on, late,
      pct(on, d0), pct(on, del),
      open, breach, pct(breach, d0)
    ]);
  });
  var totalBreach = T.late + T.open;

  const cv = _drawReport({
    title: 'ON-TIME & BREACH REPORT',
    sub: 'All Hubs (incl. GitaB / Ghaziabad) • Data Date: ' + dataDateLabel() + ' • ' + nowStampStr() + ' • On-time = Delivered ≤ Ideal Delivery End',
    kpis: [
      {l:'D0 DISPATCHED', v:T.d0, c:'#2563eb'},
      {l:'DELIVERED', v:T.del, c:'#16a34a'},
      {l:'ON-TIME', v:T.onTime, c:'#059669'},
      {l:'ON-TIME %', v:pct(T.onTime, T.d0), c:'#0f766e'},
      {l:'LATE', v:T.late, c:'#ea580c'},
      {l:'OPEN PAST TAT', v:T.open, c:'#b45309'},
      {l:'BREACH', v:totalBreach, c:'#dc2626'},
      {l:'BREACH %', v:pct(totalBreach, T.d0), c:'#991b1b'}
    ],
    cols: [
      {h:'S.No', w:5},
      {h:'Hub / Store', w:22, align:'left'},
      {h:'D0', w:7},
      {h:'Delivered', w:9},
      {h:'On-Time', w:8},
      {h:'Late', w:7},
      {h:'On-Time % (D0)', w:11},
      {h:'On-Time % (Del)', w:11},
      {h:'Open (past TAT)', w:10},
      {h:'Total Breach', w:10},
      {h:'Breach %', w:9}
    ],
    rows: rows,
    cellStyle: function(ri, ci, v) {
      if (ci === 6 || ci === 7) {
        var n = Number(String(v).replace('%',''));
        if (isNaN(n)) return null;
        // after _proCol light green -> dark, use white text
        if (n >= 85) return { bg:'#bbf7d0', fg:'#ffffff', bold:true };
        if (n >= 70) return { bg:'#fef9c3', fg:'#854d0e', bold:true };
        return { bg:'#fecaca', fg:'#7f1d1d', bold:true };
      }
      if (ci === 10) {
        var n = Number(String(v).replace('%',''));
        if (isNaN(n)) return null;
        if (n <= 15) return { bg:'#bbf7d0', fg:'#ffffff', bold:true };
        if (n <= 25) return { bg:'#fef9c3', fg:'#854d0e', bold:true };
        return { bg:'#fecaca', fg:'#7f1d1d', bold:true };
      }
      return null;
    },
    total: ['', 'TOTAL', T.d0, T.del, T.onTime, T.late, pct(T.onTime,T.d0), pct(T.onTime,T.del), T.open, totalBreach, pct(totalBreach,T.d0)],
    footer: window.PNG_FOOTER
  });
  _save(cv, 'OnTime_Breach_AllHubs_' + (typeof dlTag === 'function' ? dlTag() : (window.__dataDate || todayStr())) + '.png');
  (document.getElementById('statusMsg')||{}).innerText = '✅ On-Time & Breach PNG downloaded (GitaB / all hubs)';
}



