    }).join('');
    if (ind.length) { if (warnShown) { st(''); warnShown = false; } }
    else if (voices.length) { warnShown = true; st('Indian awaaz nahi mili, default awaaz chal rahi hai. Windows: Settings → Time & language → Speech → Add voices (English India / Hindi); ya Edge mein Microsoft Neerja / Swara.'); }
  }
  // Browsers load voices late: retry for a few seconds before concluding that none exist.
  function retryVoices(n){
    loadVoices();
    if (!voices.length && n > 0) setTimeout(function(){ retryVoices(n - 1); }, 500);
    else if (!voices.length && window.speechSynthesis) { warnShown = true; st('Is browser mein bolne wali awaaz (speech) available nahi. Chrome ya Edge try karein.'); }
  }
  function chosenVoice(){
    var cur = ''; try { cur = localStorage.getItem(VKEY) || ''; } catch (e) {}
    var byName = cur && voices.filter(function(v){ return v.name === cur; })[0];
    if (byName) return byName;
    var ind = voices.filter(isIndian).sort(function(a, b){ return score(b) - score(a); });
    return ind[0] || null;   // none: speak() leaves voice unset and only gives the engine an en-IN/hi-IN language hint
  }
  window.botPickVoice = function(name){
    try { localStorage.setItem(VKEY, name || ''); } catch (e) {}
    speakText('Namaste, main Shiway hoon. Main aapse friendly Hindi-English mix mein baat karungi. Aaj main aapki kya help karun?', true);
  };
  if (window.speechSynthesis) {
    retryVoices(8);
    if (window.speechSynthesis.addEventListener) window.speechSynthesis.addEventListener('voiceschanged', loadVoices);
  }

  function speakText(raw, isSample){
    if (!window.speechSynthesis || !raw) return;
    var t = String(raw).replace(/Figures are based only on the data currently loaded in this dashboard\.?/gi, '')
      .replace(/[|•]/g, ', ').replace(/\n+/g, '. ').replace(/%/g, ' percent').replace(/\s+/g, ' ').trim();
    // Speech-only pronunciation help: Devanagari makes Hindi words clearer on Indian TTS voices.
    // Keep the on-screen answer unchanged; replace only common Roman-Hindi words for speaking.
    var hiSpeak = {
      'baat':'बात', 'baatein':'बातें', 'batao':'बताओ', 'bataiye':'बताइए', 'bata':'बताइए',
      'hai':'है', 'hain':'हैं', 'hoon':'हूँ', 'main':'मैं', 'aap':'आप', 'ka':'का', 'ki':'की', 'ke':'के',
      'mein':'में', 'aur':'और', 'nahi':'नहीं', 'nahin':'नहीं', 'kya':'क्या', 'kaise':'कैसे', 'kyun':'क्यों',
      'pehle':'पहले', 'abhi':'अभी', 'aaj':'आज', 'kal':'कल', 'pichhle':'पिछले', 'sabse':'सबसे',
      'kami':'कमी', 'zyada':'ज़्यादा', 'dekhein':'देखें', 'check karein':'चेक करें', 'pooch sakte hain':'पूछ सकते हैं',
      'rider ki':'राइडर की', 'riders ki':'राइडर्स की', 'data load nahi hai':'डेटा लोड नहीं है',
      'Namaste':'नमस्ते', 'namaste':'नमस्ते'
    };
    var _v = chosenVoice();
    var canHindi = _v && (/^hi[-_]IN$/i.test(_v.lang) || /neerja|swara|madhur|prabhat/i.test(_v.name || ''));
    if (canHindi) Object.keys(hiSpeak).sort(function(a,b){return b.length-a.length;}).forEach(function(k){
      var re = new RegExp('\\b' + k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\b', 'gi');
      t = t.replace(re, hiSpeak[k]);
    });
    if (t.length > 700) { t = t.slice(0, 700); t = t.slice(0, Math.max(t.lastIndexOf('. '), 200)) + '. Baaki jawab screen par dekhein.'; }
    window.speechSynthesis.cancel();
    var u = new SpeechSynthesisUtterance(t);
    var v = chosenVoice();
    if (v) { u.voice = v; u.lang = v.lang; } else { u.lang = 'en-IN'; }
    u.rate = 0.95; u.pitch = 1.05;
    window.speechSynthesis.speak(u);
  }

  // Wrap askBot so every answer can be spoken according to the selected mode.
  var original = window.askBot;
  if (typeof original === 'function') {
