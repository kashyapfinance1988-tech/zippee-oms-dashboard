    }).join('') || '<tr><td colspan="4" style="text-align:center;color:var(--text-muted);">OFD timestamps nahi mile</td></tr>';
    if (ofdKpis) {
      const avg = tN ? tMin/tN : 0;
      ofdKpis.innerHTML = [
        ['With OFD time', tN, '#38bdf8'],
        ['Avg First OFD', String(Math.floor(avg/60)).padStart(2,'0') + ':' + String(Math.round(avg%60)).padStart(2,'0'), '#a78bfa'],
