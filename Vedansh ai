  function delta(a,suf){var d=a[a.length-1]-a[a.length-2];return '<span style="color:'+(d>0.5?'#34d399':d<-0.5?'#f87171':'#94a3b8')+'">'+(d>0.5?'\u25B2 ':d<-0.5?'\u25BC ':'\u2192 ')+Math.abs(d).toFixed(0)+suf+' vs pichhla din</span>';}
  function card(title,svg,d){return '<div style="border:1px solid var(--border);border-radius:10px;padding:10px"><div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px"><b>'+title+'</b><span style="font-size:12px">'+d+'</span></div>'+svg+'</div>';}
  var c=[card('Login % '+(hk?'(hub)':'(overall)'),lineSvg(labels,login,'#38bdf8',true),delta(login,'pt')),
         card('Riders (actual)',lineSvg(labels,riders,'#a78bfa',false),delta(riders,''))];
  if(!hk){c.push(card('Delivery %',lineSvg(labels,rate,'#34d399',true),delta(rate,'pt')));c.push(card('Orders',lineSvg(labels,orders,'#fbbf24',false),delta(orders,'')));}
