function renderOpsInsights() {
  const ops = window.__opsInsights;
  const banner = document.getElementById('opsAlertBanner');
  const yoy = document.getElementById('yoyCards');
  if (!ops) {
    if (banner) banner.innerHTML = '<div class="ops-alert yellow">Detailed CSV upload karein — Ops Insights CSV se auto-fill hota hai.</div>';
    return;
  }
  // --- Alerts ---
  if (banner) {
    let alerts = [];
    let tReady=0,tAlloc=0,tOrd=0,tDel=0,tAtt=0;
    const agg = window.__statusAgg || {};
    Object.keys(agg).forEach(function(h){
      const s = agg[h];
      tReady += s.READY||0; tAlloc += s.ALLOCATION_PENDING||0;
      Object.keys(s).forEach(function(k){ if(k.charAt(0)!=='_') tOrd += Number(s[k])||0; });
      tDel += s.DELIVERED||0; tAtt += s.DELIVERY_ATTEMPTED||0;
    });
    const rate = tOrd ? tDel/tOrd*100 : 0;
    if (tReady >= TH.readyHigh) alerts.push({c:'red', t:'🔴 READY backlog high: ' + tReady + ' orders — warehouse clear priority'});
    if (tAlloc >= TH.allocHigh) alerts.push({c:'yellow', t:'🟡 ALLOCATION_PENDING: ' + tAlloc + ' — rider assignment pending'});
    if (rate < TH.delLow && tOrd >= 50) alerts.push({c:'red', t:'🔴 Delivery % low: ' + rate.toFixed(1) + '% — focus OFD + re-attempts'});
    else if (rate >= TH.delOk) alerts.push({c:'green', t:'🟢 Delivery % healthy: ' + rate.toFixed(1) + '%'});
    if (tAtt >= TH.attHigh) alerts.push({c:'yellow', t:'🟡 Attempted/NDR: ' + tAtt + ' — check reasons below'});
    // hub level
    statusWarehouseList(agg).forEach(function(w){
      const k = Object.keys(agg).find(function(x){ return hubKey(x)===hubKey(w[1])||hubKey(x)===hubKey(normalizeHub(w[1])); });
      if (!k) return;
      const s = agg[k];
      let ord=0; Object.keys(s).forEach(function(x){ if(x.charAt(0)!=='_') ord+=Number(s[x])||0; });
      const del = s.DELIVERED||0;
      const r = ord ? del/ord*100 : 0;
      if (ord >= 30 && r < TH.delLow) alerts.push({c:'red', t:'🔴 ' + w[0] + ' del ' + r.toFixed(0) + '% (' + del + '/' + ord + ')'});
      if ((s.READY||0) >= TH.readyHigh) alerts.push({c:'yellow', t:'🟡 ' + w[0] + ' READY ' + s.READY});
    });
    banner.innerHTML = alerts.length ? alerts.map(function(a){ return '<div class="ops-alert ' + a.c + '">' + a.t + '</div>'; }).join('') : '<div class="ops-alert green">🟢 No critical alerts</div>';
  }
  // --- Yesterday vs Today ---
  if (yoy) {
    try {
      const h = loadMap(HIST_KEY);
      const cur = window.__dataDate || todayStr();
      const keys = Object.keys(h).sort();
      const idx = keys.indexOf(cur);
      const prev = idx > 0 ? h[keys[idx-1]] : null;
      const now = h[cur];
      if (now && prev) {
        const cR = now.orders ? now.delivered/now.orders*100 : 0;
        const pR = prev.orders ? prev.delivered/prev.orders*100 : 0;
        const cL = now.planned ? now.actual/now.planned*100 : 0;
        const pL = prev.planned ? prev.actual/prev.planned*100 : 0;
        function card(title, a, b, suffix) {
          const d = a - b;
          const col = d > 0.5 ? '#34d399' : (d < -0.5 ? '#f87171' : '#94a3b8');
          const arrow = d > 0.5 ? '▲' : (d < -0.5 ? '▼' : '→');
          return '<div style="background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:12px 16px;min-width:140px;"><div style="font-size:11px;color:var(--text-muted);">' + title + '</div><div style="font-size:20px;font-weight:800;">' + a.toFixed(0) + suffix + '</div><div style="font-size:12px;color:' + col + ';">' + arrow + ' ' + Math.abs(d).toFixed(0) + suffix + ' vs kal</div></div>';
        }
        yoy.innerHTML = '<div style="width:100%;font-size:13px;color:var(--text-muted);margin-bottom:4px;">📅 Kal vs Aaj (' + prettyDate(keys[idx-1]) + ' → ' + prettyDate(cur) + ')</div>' +
          card('Delivery %', cR, pR, '%') + card('Login %', cL, pL, '%') +
          card('Orders', now.orders||0, prev.orders||0, '') + card('Riders', now.actual||0, prev.actual||0, '');
      } else {
        yoy.innerHTML = '<div style="font-size:12px;color:var(--text-muted);">Kal ka snapshot available nahi — 2 din data save hone ke baad compare dikhega.</div>';
      }
    } catch(e) { yoy.innerHTML = ''; }
  }
  // --- NDR ---
  const ndrBody = document.getElementById('ndrBody');
  if (ndrBody) {
    const totalN = Object.values(ops.ndr).reduce(function(a,b){ return a+b; }, 0) || 1;
