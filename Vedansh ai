<style id="shiway-v56-new-layout">
:root{
  --bg:#eef2f7;--surface:#fff;--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;--line2:#cbd5e1;
  --navy:#0b1f3a;--navy2:#122a4a;--teal:#0d9488;--teal2:#0f766e;
  --blue:#1d4ed8;--green:#059669;--amber:#d97706;--red:#dc2626;--purple:#7c3aed;
  --shadow:0 1px 3px rgba(15,23,42,.06),0 4px 14px rgba(15,23,42,.05);
  --shadow2:0 8px 28px rgba(15,23,42,.1);--r:12px;--rsm:8px;
  --sidebar-w:240px;--topbar-h:58px;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:var(--bg);color:var(--ink);
  font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:14px;line-height:1.5;
  -webkit-font-smoothing:antialiased}
body{display:flex;flex-direction:column;min-height:100vh}

/* ===== TOP APP BAR ===== */
.app-topbar{
  height:var(--topbar-h);background:linear-gradient(105deg,#0b1f3a 0%,#143a5c 55%,#0f766e 100%);
  color:#fff;display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:0 20px;position:sticky;top:0;z-index:100;box-shadow:0 2px 12px rgba(0,0,0,.18);
  flex-shrink:0;
}
.app-brand{display:flex;align-items:center;gap:12px;min-width:0}
.app-brand-mark{
  width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.15);
  display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;
  border:1px solid rgba(255,255,255,.25);flex-shrink:0;
}
.app-brand h1{font-size:16px;font-weight:800;letter-spacing:-.02em;white-space:nowrap}
.app-brand span{font-size:11px;opacity:.8;font-weight:500;display:block;margin-top:1px}
.app-top-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.app-top-actions .btn{min-height:34px;padding:6px 12px;font-size:12px}
.app-top-actions .btn-ghost{
  background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.28);
}
.app-top-actions .btn-ghost:hover{background:rgba(255,255,255,.22)}
#dataDateBar{
  display:inline-flex;align-items:center;padding:4px 12px;border-radius:999px;
  background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);
  color:#ecfdf5;font-size:11px;font-weight:600;white-space:nowrap;
}
#statusMsg{font-size:12px;color:#a7f3d0;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* ===== BODY SHELL ===== */
.app-shell{display:flex;flex:1;min-height:0;width:100%;max-width:1760px;margin:0 auto}
.app-sidebar{
  width:var(--sidebar-w);flex-shrink:0;background:var(--navy);color:#94a3b8;
  display:flex;flex-direction:column;padding:14px 10px;gap:4px;
  border-right:1px solid var(--navy2);position:sticky;top:var(--topbar-h);
  height:calc(100vh - var(--topbar-h));overflow-y:auto;z-index:40;
}
.app-sidebar .nav-label{
  font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:#64748b;
  padding:10px 12px 6px;font-weight:700;
}
.app-sidebar .tab, .app-sidebar button.tab{
  width:100%;text-align:left;display:flex;align-items:center;gap:10px;
  min-height:40px;padding:9px 12px;border:none;border-radius:9px;
  background:transparent;color:#94a3b8;font-size:12.5px;font-weight:600;
  cursor:pointer;transition:background .15s,color .15s;font-family:inherit;
}
.app-sidebar .tab:hover{background:rgba(255,255,255,.07);color:#fff}
.app-sidebar .tab.active{
  background:var(--teal);color:#fff;box-shadow:0 3px 10px rgba(13,148,136,.3);
}
.app-sidebar .tab .nav-ico{width:18px;text-align:center;opacity:.85;flex-shrink:0}

.app-main{
  flex:1;min-width:0;padding:16px 18px 28px;overflow-x:hidden;
  display:flex;flex-direction:column;gap:14px;
}

/* Hide old shell classes interference */
.container,.exec-shell{display:contents !important;max-width:none !important;width:auto !important;margin:0 !important;padding:0 !important;background:transparent !important;border:none !important;box-shadow:none !important;grid-template-columns:none !important}
.exec-sidebar,.tabs.exec-sidebar{display:none !important} /* replaced by app-sidebar */
.exec-hero,.nk-hero,#shiwayHead,.header-card{display:none !important} /* replaced by topbar */
.exec-wide{display:block;width:100%}
.exec-workspace,.tab-content.active{display:block}

/* ===== KPI STRIP ===== */
.kpi-banner{
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;
}
.kpi-box{
  border-radius:12px;padding:16px;text-align:center;color:#fff;
  box-shadow:var(--shadow);border:none;
}
.kpi-box .lbl{font-size:10px;text-transform:uppercase;letter-spacing:.06em;opacity:.9;font-weight:700}
.kpi-box .val{font-size:26px;font-weight:800;margin-top:4px;letter-spacing:-.02em}
.kpi-box .sub{font-size:11px;opacity:.85;margin-top:2px}
.kpi-purple{background:linear-gradient(135deg,#4c1d95,#6d28d9)}
.kpi-emerald{background:linear-gradient(135deg,#064e3b,#059669)}
.kpi-crimson{background:linear-gradient(135deg,#9f1239,#e11d48)}
.kpi-ruby{background:linear-gradient(135deg,#9a3412,#ea580c)}

/* ===== CARDS & WORKSPACE ===== */
.tab-content{display:none}
.tab-content.active{display:block}
.card,.v3-card,.v3-hubcard,.report-card-png,.tc-wrap,.tc-center{
  background:var(--surface);border:1px solid var(--line);border-radius:var(--r);
  box-shadow:var(--shadow);padding:16px 18px;margin-bottom:14px;color:var(--ink);
}
.card h2,.card h3,.exec-workspace h2,.exec-workspace h3,h2,h3{
  color:var(--navy);font-size:15px;font-weight:700;letter-spacing:-.02em;
  margin:0 0 12px;padding-bottom:8px;border-bottom:1px solid var(--line);
}
h1{color:var(--navy);font-weight:800}

/* ===== TABLES ===== */
.table-wrap,.oms-tablewrap{
  max-height:560px;overflow:auto;border:1px solid var(--line);border-radius:var(--rsm);background:#fff;
}
table{width:100%;border-collapse:separate;border-spacing:0;font-size:13px;white-space:nowrap;color:var(--ink)}
th,thead th{
  background:#f1f5f9;color:#334155;font-size:11px;font-weight:700;text-transform:uppercase;
  letter-spacing:.04em;padding:10px 12px;text-align:left;border-bottom:2px solid var(--line2);
  position:sticky;top:0;z-index:2;
}
td{padding:9px 12px;border-bottom:1px solid #f1f5f9;color:#1e293b}
tbody tr:nth-child(even) td{background:#f8fafc}
tbody tr:hover td{background:#f0f9ff}

/* ===== BUTTONS ===== */
.btn,button{
  display:inline-flex;align-items:center;gap:6px;border:none;border-radius:var(--rsm);
  padding:8px 14px;font-size:13px;font-weight:600;cursor:pointer;min-height:36px;
  font-family:inherit;transition:filter .12s;
}
.btn:hover,button:hover{filter:brightness(1.06)}
.btn-blue{background:var(--blue);color:#fff}
.btn-green{background:var(--green);color:#fff}
.btn-orange{background:#ea580c;color:#fff}
.btn-purple{background:var(--purple);color:#fff}
button.secondary,.btn-secondary{background:#334155;color:#fff}
.btn-group{display:flex;flex-wrap:wrap;gap:8px;align-items:center}

/* ===== FORMS ===== */
input,select,textarea,.search-box,.vendor-select,.editable-cell{
  background:#fff;color:var(--ink);border:1px solid var(--line2);border-radius:var(--rsm);
  padding:8px 11px;font-size:13px;min-height:36px;font-family:inherit;
}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(13,148,136,.15)}
#csvFileInput{display:none}
.note,.v3-note,.tc-note,.oms-note{font-size:12px;color:var(--muted);margin-top:8px}

/* ===== TAGS ===== */
.tag,.v3-chip,.pill{display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700}
.tag-green,.v3-g,.READY{background:#d1fae5;color:#065f46}
.tag-yellow,.v3-y,.ALLOC{background:#fef3c7;color:#92400e}
.tag-red,.v3-r,.CANCEL{background:#fee2e2;color:#991b1b}
.tag-blue,.v3-b{background:#dbeafe;color:#1e40af}
.RTO{background:#ffedd5;color:#9a3412}

/* ===== AUDIT BAR ===== */
#zippeeOpsAudit{
  background:var(--surface);border:1px solid var(--line);border-radius:var(--r);
  box-shadow:var(--shadow);overflow:hidden;margin:0;
}
#zippeeOpsAudit .zoa-head{
  background:linear-gradient(100deg,#0b1f3a,#143a5c);color:#fff;padding:10px 16px;
}
#zippeeOpsAudit .zoa-head h2{color:#fff;margin:0;font-size:13px;border:none;padding:0}
#zippeeOpsAudit .zoa-body{padding:12px 16px}
#zippeeOpsAudit .zoa-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:10px}
#zippeeOpsAudit .zoa-kpi{background:#f8fafc;border:1px solid var(--line);border-radius:10px;padding:10px 12px}
#zippeeOpsAudit .zoa-kpi small{display:block;color:var(--muted);font-size:10px;font-weight:600;text-transform:uppercase}
#zippeeOpsAudit .zoa-kpi strong{font-size:18px;color:var(--ink)}
#zippeeOpsAudit .zoa-status{
  background:#f1f5f9;border:1px solid var(--line);border-left:4px solid var(--teal);
  border-radius:8px;padding:8px 12px;color:#334155;font-size:12px;
}
#zippeeOpsAudit .zoa-actions{margin-top:10px;display:flex;gap:8px}

/* ===== REPORT PNG ===== */
.report-card-png{background:#fff;border:1px solid var(--line2);padding:20px}
.report-header-png{
  background:linear-gradient(110deg,#0b1f3a,#143a5c);color:#fff;border-radius:10px;
  padding:14px;text-align:center;margin-bottom:14px;
}
.report-title-png{font-size:18px;font-weight:800;color:#fff !important;-webkit-text-fill-color:#fff !important;background:none !important}
.report-time-png{font-size:12px;color:#cbd5e1 !important;margin-top:4px}
table.table-png{width:100%;border-collapse:collapse;font-size:12px}
table.table-png th{background:#0b1f3a;color:#fff;border:1px solid #132f54;position:static;padding:10px 8px;text-align:center}
table.table-png td{padding:8px;border-bottom:1px solid #e2e8f0;text-align:center;color:#334155}
table.table-png tbody tr:nth-child(even) td{background:#f8fafc}
table.table-png td.diff-pos{background:#166534 !important;color:#ffffff !important;font-weight:800}
table.table-png td.diff-neg{background:#fee2e2 !important;color:#991b1b !important;font-weight:700}
table.table-png tfoot td{background:#0b1f3a;color:#fff;font-weight:800}
.png-footer-text{text-align:center;font-size:11px;color:var(--muted);margin-top:12px;font-weight:600}

/* ===== TATA / TC ===== */
.tc-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}
.tc-head h2{border:none;margin:0;padding:0;font-size:16px}
.tc-ctl{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:10px 0}
.tc-card{background:var(--navy);color:#fff;border-radius:12px;padding:14px 16px;margin-bottom:10px}
.tc-card h3{color:#fff;border:none;margin:0 0 4px;padding:0}
.tc-card .big{font-size:28px;font-weight:800}
.tc-card .sub{font-size:12px;opacity:.85}
.tc-bar{background:var(--navy);color:#fff;padding:10px 14px;border-radius:10px 10px 0 0;
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.tc-bar .btn{background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.3)}

/* ===== V3 / FILTERS ===== */
.v3-filter{display:flex;flex-wrap:wrap;gap:10px;align-items:center;background:#fff;
  border:1px solid var(--line);border-radius:var(--r);padding:10px 14px;margin-bottom:12px}
.v3-filter label{display:flex;align-items:center;gap:6px;color:var(--muted);font-weight:600;font-size:12px}
.v3-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-bottom:10px}
.v3-grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.v3-up{color:var(--green);font-weight:700}.v3-dn{color:var(--red);font-weight:700}.v3-dim{color:var(--muted)}
.v3-hubs{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
.v3-hubcard pre{white-space:pre-wrap;font:12px/1.45 ui-monospace,Menlo,Consolas,monospace;
  background:#f1f5f9;padding:10px;border-radius:8px;margin:8px 0;color:#334155;max-height:200px;overflow:auto}
.v3-bar{height:8px;border-radius:4px;background:#e2e8f0;overflow:hidden;min-width:70px}
.v3-bar i{display:block;height:100%;background:var(--teal)}
.v3-kpis{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.v3-kpi{background:#f8fafc;border:1px solid var(--line);border-radius:10px;padding:10px 14px;min-width:110px}
.v3-kpi small{display:block;font-size:10px;text-transform:uppercase;color:var(--muted)}.v3-kpi b{font-size:18px}

/* ===== OMS ===== */
#omsPanel{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);overflow:hidden;color:var(--ink);margin:0}
#omsPanel .oms-head{padding:14px 16px;background:linear-gradient(120deg,#0b1f3a,#0f766e);color:#fff}
#omsPanel .oms-head h2{color:#fff;margin:0;border:none;padding:0}
#omsPanel .oms-tools{display:flex;flex-wrap:wrap;gap:8px;padding:12px 16px;background:#f8fafc;border-bottom:1px solid var(--line);align-items:center}
#omsPanel .oms-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:14px 16px}
#omsPanel .kpi{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px}
#omsPanel .oms-tabs{display:flex;gap:6px;padding:0 16px 10px;flex-wrap:wrap}
#omsPanel .oms-tabs button{background:#e2e8f0;color:#334155}
#omsPanel .oms-tabs button.active{background:var(--navy);color:#fff}
#omsPanel .oms-tablewrap{margin:0 16px 16px}
#omsPanel th{background:#0b1f3a;color:#fff}

/* ===== FOOTER ===== */
.nk-foot,footer{
  background:var(--navy);color:#94a3b8;padding:14px 20px;text-align:center;font-size:12px;
  border:none;margin-top:auto;flex-shrink:0;
}
.nk-foot b,footer b{color:#fff}

/* ===== HIDE LEGACY ===== */
#controlTowerPanel,#ctSheetsBox,#zippeeTeamSync,#v20Bar,#v20Nav,#v20Tip,#v20Alerts,#v20Panel,#omsQuickFab,#zBg{display:none !important}

/* ===== ALERTS ===== */
#opsAlertBanner .ops-alert,#alertBox>div{padding:10px 14px;border-radius:9px;margin-bottom:8px;font-size:13px;font-weight:600}
.ops-alert.red{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
.ops-alert.yellow{background:#fffbeb;border:1px solid #fde68a;color:#92400e}
.ops-alert.green{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}

#riderModal{color-scheme:light}
#riderModal thead th{background:#0b1f3a !important;color:#fff !important}
#riderModal tbody tr:nth-child(odd){background:#fff}
#riderModal tbody tr:nth-child(even){background:#f8fafc}
#riderModal tbody td{color:#0f172a}

#v3PrintHdr{display:none;font:700 16px Inter,sans-serif;margin:0 0 8px;color:var(--navy)}
.badge{display:inline-block;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);
  color:#fff;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700}

/* ===== MOBILE ===== */
@media(max-width:960px){
  .app-shell{flex-direction:column}
  .app-sidebar{
    width:100%;height:auto;position:relative;top:auto;
    flex-direction:row;overflow-x:auto;padding:8px;gap:4px;
    border-right:none;border-bottom:1px solid var(--navy2);
  }
  .app-sidebar .nav-label{display:none}
  .app-sidebar .tab{width:auto;flex:0 0 auto;min-width:max-content;white-space:nowrap;min-height:36px}
  .app-main{padding:12px}
  .kpi-banner,#zippeeOpsAudit .zoa-grid,#omsPanel .oms-kpis{grid-template-columns:repeat(2,1fr)}
  .app-topbar{flex-wrap:wrap;height:auto;padding:10px 14px;gap:10px}
  .app-brand h1{font-size:14px}
  .v3-grid2{grid-template-columns:1fr}
  .table-wrap table,.oms-tablewrap table{min-width:520px}
}
@media(max-width:480px){
  .kpi-banner{grid-template-columns:1fr 1fr}
  .app-top-actions .btn{padding:6px 10px;font-size:11px}
}

/* ===== PRINT ===== */
@media print{
  @page{size:A4 landscape;margin:8mm}
  body{background:#fff}
  .app-topbar,.app-sidebar,.btn,button,.btn-group,#alertBox,.search-box,input[type=file],.v3-filter{display:none !important}
  .tab-content{display:none !important}
  .tab-content.active,.tab-content.v3-print-on{display:block !important}
  #v3PrintHdr{display:block !important}
  .card{break-inside:avoid;box-shadow:none;border:1px solid #ddd}
  .table-wrap{max-height:none;overflow:visible}
  table{font-size:10px}th,td{padding:4px 6px}
  .app-main{padding:0}
}

button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,.tab:focus-visible{
  outline:3px solid rgba(13,148,136,.4);outline-offset:2px;
}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms !important;transition-duration:.01ms !important}}
</style>


