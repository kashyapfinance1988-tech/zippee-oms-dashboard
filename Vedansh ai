/* ---------- speed: show progress + timing ---------- */
function memoParse(){
  const p=window.parseCSV;if(typeof p!=='function'||p.__v3)return;
  let lastT=null,lastR=null;
  const m=function(text){
    if(typeof text==='string'&&text.length>200000){if(text===lastT)return lastR;const r=p.apply(this,arguments);lastT=text;lastR=r;return r;}
    return p.apply(this,arguments);
  };m.__v3=1;window.parseCSV=m;
}
function backfillDay(text,key){
  // multi-day CSV: older days ke hub/rider numbers Compare ke liye save karo
  try{
    const rows=parseCSV(text);if(rows.length<2)return;
    const hd=rows[0].map(h=>String(h).toLowerCase().replace(/[^a-z0-9]/g,''));
    const iH=hd.findIndex(h=>h.includes('warehouse')||h.includes('hub')||h.includes('darkstore'));
    const iS=hd.findIndex(h=>h.includes('status'));
    const iR=hd.findIndex(h=>h.includes('ridername')||(h.includes('rider')&&!h.includes('id')));
    const iI=hd.findIndex(h=>h.includes('riderid')||h.includes('rideruserid'));
    if(iH<0||iS<0)return;
    const hubs={},riders={};
    for(let i=1;i<rows.length;i++){
      const r=rows[i],hub=normalizeHub(r[iH]),k=hubKey(hub),st=String(r[iS]||'').toUpperCase();
      const o=hubs[k]=hubs[k]||{store:hub,ord:0,del:0,att:0,planned:0,actual:0};
      o.ord++;const isD=st.includes('DELIVERED')&&!st.includes('ATTEMPT');if(isD)o.del++;else if(st.includes('ATTEMPT')||st.includes('NDR'))o.att++;
      const nm=iR>=0?String(r[iR]||'').trim():'';
      if(nm){const rk=riderKey({id:iI>=0?r[iI]:'',name:nm}),x=riders[rk]=riders[rk]||{n:nm,h:hub,o:0,d:0};x.o++;if(isD)x.d++;}
    }
    const m=loadMap(H2);const old=m[key]||{};
    // keep planned/actual from history if we had them
    const hist=(loadMap(HIST_KEY)[key]||{}).hubs||{};
    Object.keys(hubs).forEach(k=>{if(hist[k]){hubs[k].planned=hist[k].planned||0;hubs[k].actual=hist[k].actual||0;}});
    m[key]={hubs:hubs,riders:riders,at:Date.now(),backfill:1};
    const keys=Object.keys(m).sort();while(keys.length>45)delete m[keys.shift()];
    saveMap(H2,m);refreshSoon();
  }catch(e){console.error('v3 backfill',e);}
}
function wrapOmsDay(){
  const o=window.omsSaveDay;if(typeof o!=='function'||o.__v3)return;
  const w=function(text,key){try{backfillDay(text,key);}catch(e){}return o.apply(this,arguments);};w.__v3=1;window.omsSaveDay=w;
}
