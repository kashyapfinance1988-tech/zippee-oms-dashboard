  function score(v){
    var n = v.name || '', sc = 0;
    if (/^en[-_]IN$/i.test(v.lang)) sc += 50;        // en-IN reads the Roman-script Hinglish replies best
    else if (/^hi[-_]IN$/i.test(v.lang)) sc += 40;
    if (FEMALE.test(n)) sc += 30;
    if (MALE.test(n)) sc -= 40;
    if (/natural|online/i.test(n)) sc += 10;         // neural voices (Edge / Windows) sound much more natural
    return sc;
  }
  function loadVoices(){
    voices = (window.speechSynthesis && window.speechSynthesis.getVoices && window.speechSynthesis.getVoices()) || [];
    var sel = $('botVoiceSel'); if (!sel) return;
    var ind = voices.filter(isIndian).sort(function(a, b){ return score(b) - score(a); });
    var list = ind.length ? ind : voices.slice().sort(function(a, b){ return (/^en/i.test(b.lang) ? 1 : 0) - (/^en/i.test(a.lang) ? 1 : 0); });
    var cur = ''; try { cur = localStorage.getItem(VKEY) || ''; } catch (e) {}
    sel.innerHTML = '<option value="">' + (ind.length ? 'Auto (best Indian female)' : 'Auto (default awaaz)') + '</option>' + list.map(function(v){
