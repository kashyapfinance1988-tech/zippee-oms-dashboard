<script>
// ---- Google Sheet bridge: CSV auto-load + shared manual values (OZI / planned / auto flags) ----
(function () {
  var SHARED = {};
  SHARED[PMAP_KEY] = 1; SHARED[AMAP_KEY] = 1; SHARED[AUTO_KEY] = 1;
  var cache = {};
  var inflight = 0;
  function hasBridge() { return !!(window.google && google.script && google.script.run); }
  function setMsg(t) { var m = document.getElementById('statusMsg'); if (m) m.innerText = t; }

  // ---- CSV from sheet ----
  var lastTxt = '';
  var lastBridgeWarn = 0;
  function loadViaGvizTeamSync(force) {
    // Standalone HTML: use Team Sync public-sheet pull (no Apps Script needed)
    if (window.zippeeTeamSync && typeof window.zippeeTeamSync.pull === 'function') {
      if (force) setMsg('☁️ Google Sheet se load ho raha hai (Team Sync)...');
      try {
        window.zippeeTeamSync.pull();
      } catch (e) {
        if (force) setMsg('❌ Sheet load fail: ' + (e && e.message ? e.message : e));
      }
      return true;
    }
    return false;
  }
  function loadSheetCsv(force) {
    // 1) Embedded in Apps Script web app → native bridge
    if (hasBridge()) {
      google.script.run
        .withSuccessHandler(function (txt) {
          if (!txt) return;
          if (!force && txt === lastTxt) return;
          lastTxt = txt;
          processDetailedCSV({ target: { files: [new File([txt], 'sheet.csv', { type: 'text/csv' })] } });
        })
        .withFailureHandler(function (e) { setMsg('❌ Sheet se data load nahi hua: ' + (e && e.message ? e.message : e)); })
        .getCsvText();
      return;
    }
    // 2) Standalone HTML → Team Sync (gviz) fallback
    if (loadViaGvizTeamSync(!!force)) return;
    // 3) No bridge, no team sync — only show tip on manual force, never spam every minute
    if (force) {
      setMsg('ℹ️ Sheet auto-sync ke liye upar Team Sync → "Load from Sheet" use karo, ya Detailed CSV manually upload karo.');
    }
  }
  window.loadSheetCsv = loadSheetCsv;

  // ---- Shared manual values ----
  function sendEntries(list) {
    if (!hasBridge() || !list.length) return;
    inflight++;
    google.script.run
      .withSuccessHandler(function () { inflight--; })
      .withFailureHandler(function (e) { inflight--; setMsg('❌ Save fail: ' + (e && e.message ? e.message : e)); })
      .saveSettingEntries(JSON.stringify(list));
  }

  var origLoad = loadMap, origSave = saveMap;
  loadMap = function (k) {
    if (SHARED[k] && cache[k]) return JSON.parse(JSON.stringify(cache[k]));
    return origLoad(k);
  };
  saveMap = function (k, m) {
    origSave(k, m);
    if (!SHARED[k]) return;
    var prev = cache[k] || {}, changed = [];
    Object.keys(m).forEach(function (hk) {
      if (String(prev[hk]) !== String(m[hk])) changed.push({ m: k, k: hk, v: m[hk] });
    });
    cache[k] = JSON.parse(JSON.stringify(m));
    sendEntries(changed);
  };

  function syncSettings() {
    if (!hasBridge() || inflight > 0) return;
    google.script.run
      .withSuccessHandler(function (json) {
        var s = JSON.parse(json || '{}'), push = [];
        Object.keys(SHARED).forEach(function (k) {
          var part = s[k] || {}, m = {};
          Object.keys(part).forEach(function (hk) {
            if (part[hk] !== '' && part[hk] !== null) m[hk] = part[hk];
          });
          // Pehle se is device par saved values ko sheet par chadhao (one-time migration)
          var local = origLoad(k);
          Object.keys(local).forEach(function (hk) {
            if (m[hk] === undefined) { m[hk] = local[hk]; push.push({ m: k, k: hk, v: local[hk] }); }
          });
          cache[k] = m;
        });
        sendEntries(push);
        renderAll();
      })
      .withFailureHandler(function (e) { setMsg('❌ Shared settings load nahi hue: ' + (e && e.message ? e.message : e)); })
      .getSettings();
  }

  window.addEventListener('load', function () {
    syncSettings();
    loadSheetCsv(true);
  });
  setInterval(function () {
    // Silent auto-refresh only when a real bridge or team-sync exists
    if (hasBridge() || (window.zippeeTeamSync && typeof window.zippeeTeamSync.pull === 'function')) {
      loadSheetCsv(false);
    }
    try { syncSettings(); } catch (eSync) {}
  }, 60 * 1000);
})();
</script>
