        }
      };
      _finalizeNew();
      // (b) older uploads saved in the browser backup (IndexedDB): merge in, then refresh the tab
      if (typeof window.omsIdbAll === 'function') {
        const _tok = (window.__newRiderTok = (window.__newRiderTok || 0) + 1);
