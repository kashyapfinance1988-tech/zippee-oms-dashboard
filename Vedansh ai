function showTab(id, btn) {
  try {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
    var panel = document.getElementById(id);
    if (!panel) {
      console.warn('showTab: panel not found →', id);
      var sm = document.getElementById('statusMsg');
      if (sm) sm.textContent = '⚠ Panel not found: ' + id;
      return;
    }
    panel.classList.add('active');
    if (btn) btn.classList.add('active');
    // Keep ARIA in sync (v49 accessibility)
    document.querySelectorAll('.tabs .tab').forEach(function(t){
      var selected = (btn && t === btn) || t.classList.contains('active');
      t.setAttribute('aria-selected', selected ? 'true' : 'false');
      t.tabIndex = selected ? 0 : -1;
    });
  } catch (err) {
    console.error('showTab error:', err);
  }
}

function getCurrentTimeStr() {
  const now = new Date();
  let h = now.getHours();
  const m = now.getMinutes().toString().padStart(2, '0');
  const ampm = h >= 12 ? 'pm' : 'am';
  h = h % 12 || 12;
  return h + ':' + m + ' ' + ampm;
}

function fixOldHubName(n) {
  const k = String(n || '').toLowerCase();
  if (k === 'dwarka sdd') return 'Janakpuri';
  if (/^gh?aziabad( sdd)?$/.test(k)) return 'Dilshad Garden';
  if (k === 'gurugram clinikally') return 'Clinikally Gurgaon Sec 29';
  return n;
}
function normalizeHub(h) {
  const raw = String(h || '').replace(/\s+/g, ' ').trim();
  if (!raw) return "Other Hub";
  const s = raw.toLowerCase().replace(/[._-]+/g, ' ').replace(/\s+/g, ' ').trim();
  // Exact source names are canonical. CSV values should display without being relabelled.
  if (/^zippee okhla sdd$/.test(s)) return "zippee_okhla_sdd";
  if (/^zippee wazir ?pur sdd$/.test(s)) return "zippee_wazirpur_sdd";
  if (/^zipp+ee noida sdd$/.test(s)) return "zipppee_noida_sdd";
  if (/^zippee ghaziabad sdd$/.test(s)) return "zippee_ghaziabad_sdd";
  if (/^zippee dwarka sdd$/.test(s)) return "zippee_dwarka_sdd";
  if (/^zippee gurugram sdd$|^zippee gurgaon sdd$/.test(s)) return "zippee_gurugram_sdd";
  if (/^faridabad sdd$|^faridabad$/.test(s)) return "Faridabad SDD";
  if (/^gurugram clinikally$|^clinikally gurgaon sec ?29$|^gurugram clinikally$/.test(s)) return "gurugram-clinikally";
  // SDD aliases with extra text ("ZD SDD Wazirpur", "Ghaziabad SDD (Dilshad Garden)", "⚠ ...") -> same canonical hub
  if (/ghaziabad|dilshad|gitab/.test(s)) return "zippee_ghaziabad_sdd";
  if (/wazir ?pur/.test(s)) return "zippee_wazirpur_sdd";
  // CSV warehouse aliases ("ZD SDD X" == "zippee_x_sdd", "ZD 1MG" == "Tata 1MG", "ZD CLK" == Clinikally) -> one canonical hub
  if (/okhla/.test(s) && /sdd/.test(s)) return "zippee_okhla_sdd";
  if (/dwarka/.test(s) && /sdd/.test(s)) return "zippee_dwarka_sdd";
  if (/noida/.test(s) && /sdd/.test(s)) return "zipppee_noida_sdd";
  if (/gurugram|gurgaon/.test(s) && /sdd/.test(s)) return "zippee_gurugram_sdd";
  if (/faridabad/.test(s) && /sdd/.test(s)) return "Faridabad SDD";
  if (/1mg/.test(s) && /rohtas/.test(s)) return "ZD 1MG Rohtas Nagar";
  if (/1mg/.test(s) && /dwarka/.test(s)) return "ZD 1MG Dwarka";   // v57: CSV name kept as is
  if (/\bclk\b/.test(s) && /gurugram|gurgaon/.test(s)) return "gurugram-clinikally";
  // Tata 1MG Malad / ZD 1MG Malad are the same hub
  if (/1mg/.test(s) && /malad/.test(s)) return "ZD 1MG Malad";
  // Friendly names remain accepted as aliases but resolve to the exact CSV warehouse label.
  if (/^okhla(?: sdd)?$/.test(s)) return "zippee_okhla_sdd";
  if (/^wazir ?pur(?: sdd)?$/.test(s)) return "zippee_wazirpur_sdd";
  if (/^noida(?: sdd)?$/.test(s)) return "zipppee_noida_sdd";
  if (/^janak ?puri$|^dwarka sdd$/.test(s)) return "zippee_dwarka_sdd";
  if (/^dilshad garden$|^gh?aziabad(?: sdd)?$|^gaziabad(?: sdd)?$|^gitab(?: hub)?$|^ghaziabad hub$/.test(s)) return "zippee_ghaziabad_sdd";
  if (/^gurgaon$|^gurugram$|^gurgaon sdd$|^gurugram sdd$/.test(s)) return "zippee_gurugram_sdd";
  if (/ozi.*dwarka|dwarka.*ozi|dwarka.*(?:sector|sec)\s*3\b/.test(s)) return "OZI Dwarka";
  if (/dwarka/.test(s) && /(sdd|same day)/.test(s)) return "zippee_dwarka_sdd";
  if (/dwarka/.test(s)) return "Dwarka Hub";
  if (/clinikally|clinically/.test(s)) return "gurugram-clinikally";
  if (/malviya/.test(s)) return "Ozi Malviya Nagar";
  // Bisrakh == Noida Sec 1 (same OZI hub)
  if (/bisrakh|noida\s*sec(?:tor)?\s*1\b|\bsec(?:tor)?\s*1\b.*noida|noida.*\bsec(?:tor)?\s*1\b/.test(s)) return "Ozi Bisrakh";
  if (/saveri|noida saveri/.test(s)) return "Ozi Noida Saveri";
  if (/gurugram|gurgaon/.test(s)) {
    if (/\b84\b|sec(?:tor)?\s*84\b/.test(s)) return "Ozi Gurugram Sec 84";
    if (/\b52\b|sec(?:tor)?\s*52\b/.test(s)) return "Ozi Gurugram Sec 52";
    return "zippee_gurugram_sdd";
  }
  if (/greater noida|gr noida|noida ext/.test(s)) return "Greater Noida SDD";
  if (/noida/.test(s)) {
    if (/\b62\b|sec(?:tor)?\s*62\b/.test(s)) return "Ozi Noida 62";
    // Sec 1 already mapped to Bisrakh above
    return "zipppee_noida_sdd";
  }
  // Unknown SDD names are kept in their source form instead of silently changing the hub.
  if (/\bsdd\b/.test(s)) return raw;
  return raw;
}

// Friendly label for UI tables (CSV codes stay canonical for matching)
function displayHubName(h) {
  const raw = String((h && h.store) != null ? h.store : h || '').trim();
  const k = hubKey(raw);
  // Gitab / Ghaziabad hub
  if (k === 'zippeeghaziabadsdd' || k === 'dilshadgarden' || /ghaziabad|dilshad|gitab/i.test(raw)) return 'Ghaziabad SDD (Dilshad Garden)';
  if (k === 'zippeedwarkasdd' || k === 'janakpuri') return 'Dwarka SDD (Janakpuri)';
  if (k === 'zippeeokhlasdd') return 'Okhla SDD';
  if (k === 'zippeewazirpursdd') return 'Wazirpur SDD';
  if (k === 'zippeegurugramsdd') return 'Gurugram SDD';
  if (k === 'zipppeenoidasdd' || k === 'zippeenoidasdd') return 'Noida SDD';
  if (k === 'faridabadsdd') return 'Faridabad SDD';
  if (k === 'gurugramclinikally') return 'Clinikally Gurugram';
  // Bisrakh = former Noida Sec 1 (same hub)
  if (k === 'ozibisrakh' || /bisrakh|noida\s*sec(?:tor)?\s*1/i.test(raw)) return 'Ozi Bisrakh (Noida Sec 1)';
  if (k === 'ozinoidasaveri') return 'Ozi Noida Saveri';
  if (k === 'ozinoida62') return 'Ozi Noida 62';
  if (k === 'ozigurugramsec84') return 'Ozi Gurugram Sec 84';
  if (k === 'ozigurugramsec52') return 'Ozi Gurugram Sec 52';
  if (k === 'ozimalviyanagar') return 'Ozi Malviya Nagar';
  if (k === 'ozidwarka' || /ozi.*dwarka/i.test(raw)) return 'Ozi Dwarka Sector 3';
  // strip zippee_ prefix for other codes
  if (/^zipp+ee[_ ]/i.test(raw)) return raw.replace(/^zipp+ee[_ ]+/i, '').replace(/_/g, ' ').replace(/\bsdd\b/i, 'SDD');
  return raw || 'Other Hub';
}

// Canonical hub key so "Wazirpur", "Wazirpur SDD", "Gurgaon", "Gurugram SDD" etc. match the same hub.
function hubKey(s) {
  const n = normalizeHub(s);
  return String(n || '').toLowerCase()
    .replace(/gurgaon/g, 'gurugram').replace(/sector/g, 'sec')
    .replace(/[^a-z0-9]/g, '').replace(/^ozidwarka.*$/, 'ozidwarka');
}
