<script id="tata-csv-bridge">
(function(){
  function feedTataFromText(text){
    try{
      if(window.__tataCenters && typeof window.__tataCenters.ingest==='function'){
        window.__tataCenters.ingest(text);
      }
    }catch(e){console.warn('tata ingest',e)}
  }
  // Wrap processDetailedCSV to also feed Tata module
  function wrap(){
    var orig=window.processDetailedCSV;
    if(typeof orig!=='function' || orig.__tataBridge) return;
    window.processDetailedCSV=function(ev){
      var file=ev&&ev.target&&ev.target.files&&ev.target.files[0];
      var result=orig.apply(this,arguments);
      if(file){
        var rd=new FileReader();
        rd.onload=function(e){feedTataFromText(e.target.result)};
        try{rd.readAsText(file)}catch(err){}
      }
      return result;
    };
    window.processDetailedCSV.__tataBridge=true;
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',wrap);
  else wrap();
  // also re-wrap after other modules
  setTimeout(wrap,800);
  setTimeout(wrap,2500);
})();
</script>


