        const aid = iA >= 0 ? String(r[iA] || '').trim().toUpperCase() : '';
        if (aid) uniqueRows.set(aid, r); else uniqueRows.set('row:' + i, r);
      }
      uniqueRows.forEach(function(r) { o++;
        const status = iS >= 0 ? String(r[iS] || '').trim().toUpperCase().replace(/[ .-]+/g, '_') : '';
        if (status === 'DELIVERED') dl++;
        const nm = iR >= 0 ? String(r[iR] || '').trim() : '';
