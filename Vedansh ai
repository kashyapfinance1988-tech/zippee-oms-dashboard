  var labels=days.map(function(d){return d.slice(8)+'/'+d.slice(5,7);});
  var login=[],rate=[],orders=[],riders=[];
  days.forEach(function(d){
    var x=h[d], pl=x.planned, ac=x.actual;
    if(hk){var r=x.hubs&&x.hubs[hk]; pl=r?r.planned:0; ac=r?r.actual:0;}
