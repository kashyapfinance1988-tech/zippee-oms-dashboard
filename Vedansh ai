        var r = all[i];
        var riderHub = String((r && (r.hub || r.store || r.warehouse)) || '').trim();
        if (!riderHub || hubKey(riderHub) !== targetKey) continue;
        var id = String(r.id || r.riderId || '').trim();
        var nm = String(r.name || r.rider || '').replace(/\s+/g, ' ').trim();
        var k = (id && id !== '-') ? ('id:' + id) : ('nm:' + nm.toLowerCase());
