let _retry=0,_busy=false;
async function syncNow(reason,isRetry){
  const url=syncUrl();
  if(!url){ if(reason==='manual')syncLog('Apps Script URL set nahi hai (Control Tower me URL save karein)',false); else renderSyncLog(); return; }
  if(!/^https:\/\/script\.google\.com\/(macros\/s\/|a\/)/.test(url)){syncLog('URL galat lagta hai — /exec wala Web App URL chahiye',false);return;}
  if(_busy)return;_busy=true;
  const body=JSON.stringify(syncPayload());
  try{
    let ok=false,note='';
    try{
      const res=await fetch(url,{method:'POST',redirect:'follow',headers:{'Content-Type':'text/plain;charset=utf-8'},body:body});
      let j=null;try{j=await res.json()}catch(e){}
      if(!res.ok||(j&&j.ok===false))throw new Error((j&&j.error)||('HTTP '+res.status));
      ok=true;note='Sheet update ho gayi'+(j&&j.updatedAt?' • '+j.updatedAt:'');
    }catch(e1){
      if(e1 instanceof TypeError){ // CORS/network: blind send, cannot read reply
        await fetch(url,{method:'POST',mode:'no-cors',headers:{'Content-Type':'text/plain;charset=utf-8'},body:body});
        ok=true;note='Push request bhej di (browser confirmation block karta hai — Google Sheet kholkar verify karein)';
      }else throw e1;
    }
    _retry=0;syncLog((reason||'sync')+': '+note,ok);
  }catch(e){
    syncLog((reason||'sync')+' fail: '+(e.message||e),false);
    if(_retry<3){const wait=[20,60,180][_retry++]*1000;setTimeout(()=>{_busy=false;syncNow('retry '+_retry,true);},wait);_busy=false;return;}
  }
  _busy=false;
}
function sheetsJsonp(url){
  return new Promise((resolve,reject)=>{
    const cb='__zippeeSheetsCb_'+Date.now()+'_'+Math.floor(Math.random()*1e6);
    const script=document.createElement('script');let done=false;
    const cleanup=()=>{if(done)return;done=true;clearTimeout(timer);delete window[cb];script.remove();};
    const timer=setTimeout(()=>{cleanup();reject(new Error('Sheets response timeout — Apps Script deploy access "Anyone" check karein.'));},15000);
    window[cb]=(data)=>{cleanup();if(data&&data.ok===false)reject(new Error(data.error||'Apps Script error'));else resolve(data);};
    script.onerror=()=>{cleanup();reject(new Error('Apps Script URL load nahi hua — /exec URL aur deployment access check karein.'));};
    script.src=url+(url.includes('?')?'&':'?')+'action=load&callback='+encodeURIComponent(cb)+'&_='+Date.now();
    document.head.appendChild(script);
  });
}
