    }
  };
  reader.readAsText(file);
  e.target.value = '';
}

function exportSummaryCSV() {
  let csv = "Data Date,Downloaded,S.No,City,Hub/Store,CSV Orders,Manual Dispatch,Planned,Actual,Login %,Gap\n";
  const csvCell = function(v) {
    let x = String(v == null ? '' : v);
    if (/^[=+@\\-]/.test(x)) x = "'" + x;
    return '"' + x.replace(/"/g, '""') + '"';
  };
  hubDataList.forEach(function(h) {
    const l = h.planned > 0 ? ((h.actual / h.planned) * 100).toFixed(1) : '0';
    csv += [dataDateLabel(), nowStampStr(), h.sno, h.city, h.store, orderCell(h), manualDispatchCell(h), h.planned, h.actual, l + '%', h.actual - h.planned].map(csvCell).join(',') + '\n';
  });
  const blob = new Blob(["\ufeff" + csv], { type: 'text/csv;charset=utf-8;' });
  if (window.__dl) { window.__dl.save({ filename: 'Zippee_Hub_Summary_' + dlTag() + '.csv', data: blob }).catch(function() {}); return; }
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'Zippee_Hub_Summary_' + dlTag() + '.csv';
  document.body.appendChild(a); a.click(); a.remove();
}

// Old saved/backup data may still say "Dwarka SDD" / "Ghaziabad SDD": rename them to Janakpuri / Dilshad Garden and merge counts.
function migrateHubNames() {
  [['Dwarka SDD', 'Janakpuri'], ['Ghaziabad SDD', 'Dilshad Garden'], ['Gurugram Clinikally', 'Gurgaon Clinikally']].forEach(function(pair) {
    const oi = hubDataList.findIndex(function(h) { return String(h.store).toLowerCase() === pair[0].toLowerCase(); });
    if (oi < 0) return;
    const old = hubDataList[oi], tgt = hubDataList.find(function(h) { return h.store === pair[1]; });
    if (tgt) { tgt.actual = Math.max(Number(tgt.actual) || 0, Number(old.actual) || 0); hubDataList.splice(oi, 1); }
    else old.store = pair[1];
  });
  rawRidersList.forEach(function(r) { r.hub = fixOldHubName(r.hub); });
  newRidersList.forEach(function(r) { r.hub = fixOldHubName(r.hub); });
  hubDataList.forEach(function(h, i) { h.sno = i + 1; });
  applyAutoPlan();
  const _pm = loadMap(PMAP_KEY), _am = loadMap(AMAP_KEY);
  hubDataList.forEach(function(h) {
    if (!h.editable) return;
    const k = hubKey(h.store);
    if (_pm[k] !== undefined && !isAutoPlan(h)) h.planned = _pm[k];
    if (isManualActualHub(h) && _am[k] !== undefined) h.actual = _am[k];
  });
}


