  if (field === 'plannedOrders' && !/clinikally/i.test(hh.store)) return;
  hh[field] = Math.max(0, parseInt(val, 10) || 0);
  if (field === 'planned' && canAutoPlan(hh)) { const am = loadMap(AUTO_KEY); am[hubKey(hh.store)] = 'manual'; saveMap(AUTO_KEY, am); }
  const mk = field === 'planned' ? PMAP_KEY : (field === 'plannedOrders' ? ORD_KEY : AMAP_KEY);
  const pm = loadMap(mk); pm[hubKey(hh.store)] = hh[field]; saveMap(mk, pm);
  if (field === 'planned') { const mm = loadMap('zippee.manualPlan.v1'); mm[hubKey(hh.store)] = hh[field]; saveMap('zippee.manualPlan.v1', mm); }
