/* ---------- data helpers ---------- */
function aggFor(store){
  const agg=window.__statusAgg||{};
  const ks=Object.keys(agg).filter(x=>hubKey(x)===hubKey(store));
  if(!ks.length) return null;
  if(ks.length===1) return agg[ks[0]];
  const out={};
  ks.forEach(k=>Object.keys(agg[k]||{}).forEach(s=>{ if(s[0]!=='_') out[s]=(out[s]||0)+(+agg[k][s]||0); }));
  return out;
}
function hubStats(){
  try { hubDataList = mergeMissingHubs(hubDataList); } catch (e) {}
  return hubDataList.map(function(h){
    const s=aggFor(h.store);
    const rs=(rawRidersList||[]).filter(r=>hk(r.hub)===hk(h.store));
    const uniqRiders=new Set(rs.map(r=>String(r.id||r.name)));
    let ord=0,del=0,att=0,ready=0,alloc=0;
    if(s){Object.keys(s).forEach(k=>{if(k[0]!=='_')ord+=+s[k]||0;});del=s.DELIVERED||0;att=s.DELIVERY_ATTEMPTED||0;ready=s.READY||0;alloc=s.ALLOCATION_PENDING||0;}
    else{rs.forEach(r=>{ord+=r.orders||0;del+=r.del||0;att+=r.att||0;});}
    const actualUniq=(rs.length && !isManualActualHub(h)) ? uniqRiders.size : (h.actual||0);
    return {h:h,store:h.store,planned:h.planned||0,actual:actualUniq,ord:ord,del:del,att:att,ready:ready,alloc:alloc,riders:rs,pen:Math.max(0,ord-del-att)};
  });
}
const visHubs=()=>hubStats().filter(s=>!F.hub||hk(s.store)===hk(F.hub));
function rankedRiders(){
  const a=(rawRidersList||[]).filter(r=>riderPass(r)&&(r.orders||0)>=F.min).map(r=>({r:r,p:pctN(r.del||0,r.orders||0)}));
  a.sort((x,y)=>y.p-x.p||(y.r.del||0)-(x.r.del||0)||(y.r.orders||0)-(x.r.orders||0));
  return a;
}
function actionFor(p,o){
  if(p>=TH.star&&o>=8)return '🏅 Reward / Retain';
  if(p>=TH.good)return '✅ Keep';
  if(p>=TH.watch)return '🟡 Coach';
  if(p>=40)return '🟠 Train + Watch';
  return '🔴 Replace / Review';
}

/* ---------- history v2 (per hub + per rider, for compare / leaderboard trend) ---------- */
function saveH2(){
  if(!window.__zippeeCsvLoaded&&dataSource!=='csv')return;
  try{
    const m=loadMap(H2),d=dsDate(),hubs={},riders={};
    hubStats().forEach(s=>{hubs[hubKey(s.store)]={store:s.store,ord:s.ord,del:s.del,att:s.att,planned:s.planned,actual:s.actual};});
    const ranked=(rawRidersList||[]).slice().sort(function(a,b){return (b.orders||0)-(a.orders||0)}).slice(0,40);
    ranked.forEach(r=>{riders[riderKey(r)]={n:r.name,h:r.hub,o:r.orders||0,d:r.del||0};});
    m[d]={hubs:hubs,riders:riders,at:Date.now()};
    const keys=Object.keys(m).sort();while(keys.length>7)delete m[keys.shift()];
    Object.keys(m).sort().slice(0, -1).forEach(function(day){ if(m[day]) m[day].riders={}; });
    if (!saveMap(H2,m)) {
      try {
        var light={}; light[d]={hubs:hubs,riders:{},at:Date.now()};
        var oldKeys=Object.keys(m).sort().slice(-2);
        oldKeys.forEach(function(k){ if(k!==d && m[k]) light[k]={hubs:m[k].hubs||{},riders:{},at:m[k].at||0}; });
        localStorage.removeItem(H2);
        localStorage.setItem(H2, JSON.stringify(light));
      } catch(e2) {}
    }
  }catch(e){}
}
function prevRiderMap(){
  const m=loadMap(H2),today=dsDate(),ks=Object.keys(m).filter(k=>k<today).sort();
  return ks.length?m[ks[ks.length-1]].riders||{}:{};
}

