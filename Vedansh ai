<style id="zippee-team-bg">
/* Subtle gradient background — clear UI */
html { min-height: 100%; }
body {
  position: relative;
  isolation: isolate;
  background:
    radial-gradient(1200px 600px at 12% -10%, rgba(99, 102, 241, 0.12), transparent 55%),
    radial-gradient(900px 500px at 88% 0%, rgba(13, 148, 136, 0.10), transparent 50%),
    radial-gradient(800px 480px at 50% 100%, rgba(37, 99, 235, 0.08), transparent 45%),
    linear-gradient(165deg, #eef2f7 0%, #e8eef6 35%, #e6f0f4 70%, #eef3f8 100%) !important;
  background-attachment: fixed !important;
}
/* Optional soft team photo wash (very subtle) */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  /* FIX: pehle background-image: inherit + opacity:0 thi, isliye kuch dikhta nahi tha.
     Ab image --team-bg variable se aayegi. Neeche :root mein apni photo ka URL daalein. */
  background-image: var(--team-bg, none);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: var(--team-bg-opacity, 0.12);
}
:root{
  /* Apni photo ka URL yahan daalein, jaise: url("https://.../team.jpg") ya data:image/jpeg;base64,... */
  --team-bg: url("data:image/jpeg;base64,");
  --team-bg-opacity: 0.22;
}
body::after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(248,250,252,0.02) 40%, rgba(241,245,249,0.10) 100%);
}
.app-topbar, .app-shell, .app-sidebar, .app-main, .nk-foot, footer,
#zippeeOpsAudit, .card, .kpi-banner, .png-bar {
  position: relative;
  z-index: 1;
}
