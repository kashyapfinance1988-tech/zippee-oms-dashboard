    if(el) el.innerHTML = html;
    return el;
  };
  window.setText = function(id, text){
    var el = document.getElementById(id);
    if(el) el.textContent = text;
    return el;
  };
  // Patch common crash sites after DOM ready
  document.addEventListener('DOMContentLoaded', function(){
    // ensure showTab works with sidebar
    if(typeof window.showTab === 'function' && !window.showTab.__safe){
      var orig = window.showTab;
      window.showTab = function(id, btn){
        try { return orig.apply(this, arguments); }
        catch(e){ console.warn('showTab error', id, e); }
      };
      window.showTab.__safe = true;
    }
  });
})();
