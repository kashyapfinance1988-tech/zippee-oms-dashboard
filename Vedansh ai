// Hubs defined in code. Old saved snapshots / backups / Sheets pulls replace hubDataList wholesale,
// so any hub added later in code would vanish; mergeMissingHubs() re-adds the missing ones after a restore.
const DEFAULT_HUB_LIST = hubDataList.map(function(h) { return Object.assign({}, h); });
function mergeMissingHubs(list) {
  try {
    if (!Array.isArray(list)) return list;
    const canon = function(h) { return hubKey(normalizeHub(h.store) || h.store); };
    const have = new Set(list.map(canon));
    DEFAULT_HUB_LIST.forEach(function(d, i) {
      if (have.has(canon(d))) return;
      let at = list.length;
      for (let j = i - 1; j >= 0; j--) {
        const idx = list.findIndex(function(h) { return canon(h) === canon(DEFAULT_HUB_LIST[j]); });
        if (idx >= 0) { at = idx + 1; break; }
      }
      list.splice(at, 0, Object.assign({}, d, { actual: 0 }));
      have.add(canon(d));
    });
    // Dedupe: a row that maps to the same canonical hub as an earlier row, and has no riders/plan, is a stale leftover.
    // Keep one row per canonical hub: prefer the exact code-defined store name, drop other aliases (e.g. 'Dwarka Hub', '⚠ Dilshad Garden').
    const defaultStores = new Set(DEFAULT_HUB_LIST.map(function(d){ return String(d.store); }));
    const keep = {};
    list.forEach(function(h, i){
      const k = canon(h);
      const exact = defaultStores.has(String(h.store));
      if (!keep[k] || (exact && !keep[k].exact)) keep[k] = { i: i, exact: exact };
    });
    for (let i = list.length - 1; i >= 0; i--) {
      const kp = keep[canon(list[i])];
      if (kp.i !== i) {
        // Same hub under another name (e.g. Ozi Noida Sec 1 == Ozi Bisrakh): fold its numbers into the kept row, then drop it.
        const dst = list[kp.i], src = list[i];
        dst.actual = Math.max(Number(dst.actual) || 0, Number(src.actual) || 0);
        dst.planned = Math.max(Number(dst.planned) || 0, Number(src.planned) || 0);
        list.splice(i, 1);
        if (kp.i > i) kp.i--;
      }
    }
    const defByCanon = {};
    DEFAULT_HUB_LIST.forEach(function(d){ defByCanon[canon(d)] = d.store; });
    list.forEach(function(h){ const d = defByCanon[canon(h)]; if (d && !defaultStores.has(String(h.store))) h.store = d; });
    list.forEach(function(h, i) { h.sno = i + 1; });
  } catch (e) { console.warn('mergeMissingHubs', e); }
  return list;
}

