      const rows = parseCSV(others[day]); if (rows.length < 2) return;
      const hd = rows[0].map(function(v) { return String(v || '').replace(/^\uFEFF/, '').toLowerCase().replace(/[^a-z0-9]/g, ''); });
      const iS = hd.indexOf('currentstatus'), iR = hd.findIndex(function(x) { return x.indexOf('ridername') >= 0; }), iI = hd.indexOf('rideruserid'), iA = hd.findIndex(function(x) { return x === 'zippeeawb' || x === 'awb' || x === 'awbnumber' || x === 'ordernumber'; });
      let o = 0, dl = 0; const set = new Set(), hubAgg = {};
