  if(sel.options.length!==hubDataList.length+1){
    sel.innerHTML='<option value="">Overall (sab hubs)</option>'+hubDataList.map(function(h){return '<option value="'+E(hubKey(h.store))+'">'+E(h.store)+'</option>';}).join('');
    sel.value=cur;
