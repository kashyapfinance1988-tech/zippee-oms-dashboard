        (missingHubs.length ? ' • ℹ️ CSV mein nahi (purana data): ' + missingHubs.join(', ') : '') +
        ((badNoHub || badNoRider || badNoStatus) ? ' • ⚠️ Data check: ' + [badNoHub ? badNoHub + ' rows mein hub khali' : '', badNoRider ? badNoRider + ' rows mein rider name khali' : '', badNoStatus ? badNoStatus + ' rows mein status khali' : ''].filter(Boolean).join(', ') : '');
      window.__daySavePromises = Object.keys(split.others).map(function(k){ return window.omsSaveDay ? window.omsSaveDay(split.others[k], k) : null; });
      try { window.blBuild(split.others, window.__dataDate); } catch (eBl) { console.error('backlog', eBl); }
      window.__fullCsvText = evt.target.result; window.__fullCsvFor = split.latest;
      try { if (window.omsLoad) window.omsLoad(split.latest, file.name); } catch (e2) { console.error(e2); }
