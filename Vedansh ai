  const hub=(document.getElementById('rosterHubFilter')?.value||'').toLowerCase();
  const vendor=(document.getElementById('rosterVendorFilter')?.value||'').toLowerCase();
  const idCounts={}; OFFICIAL_RIDER_ROSTER.forEach(r=>{idCounts[r.id]=(idCounts[r.id]||0)+1;});
  const list=OFFICIAL_RIDER_ROSTER.filter(r=>(!q||[r.id,r.name,r.vendor,r.payment,r.hub,r.phone].some(v=>String(v).toLowerCase().includes(q)))&&(!hub||r.hub.toLowerCase()===hub)&&(!vendor||r.vendor.toLowerCase()===vendor));
