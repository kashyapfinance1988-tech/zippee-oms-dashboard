  let y, m, d, x;
  if ((x = t.match(/(\d{4})-(\d{1,2})-(\d{1,2})/))) { y = +x[1]; m = +x[2]; d = +x[3]; }
  else if ((x = t.match(/(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{4})/))) { d = +x[1]; m = +x[2]; y = +x[3]; }
  else if ((x = t.match(/(\d{1,2})[\s-]([A-Za-z]{3})[A-Za-z]*[\s,-]*(\d{4})/))) { d = +x[1]; m = MON[x[2].toLowerCase()]; y = +x[3]; }
  else return '';
  if (!m || m > 12 || !d || d > 31 || y < 2020 || y > 2100) return '';
  return y + '-' + String(m).padStart(2, '0') + '-' + String(d).padStart(2, '0');
