<script id="v50-td-contrast-fix">
/* cells with their own coloured background keep their own text colour (global td{color!important} was turning it white) */
(function(){
 var busy=false;
 function fix(root){
  var n=(root||document).querySelectorAll('td[style*="background"],th[style*="background"]');
  for(var i=0;i<n.length;i++){var e=n[i],c=e.style.getPropertyValue('color');
   if(c&&e.style.getPropertyPriority('color')!=='important'&&e.style.backgroundColor&&!/^(transparent|rgba\(0, 0, 0, 0\))$/.test(e.style.backgroundColor))e.style.setProperty('color',c,'important')}}
 function run(){if(busy)return;busy=true;setTimeout(function(){busy=false;try{fix()}catch(x){}},60)}
 function start(){fix();new MutationObserver(run).observe(document.body,{childList:true,subtree:true})}
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>


