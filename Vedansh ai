function parseCSV(text) {
  text = String(text == null ? '' : text).replace(/^\uFEFF/, '');
  const rows = [];
  let row = [], cur = '', quoted = false, afterQuote = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (quoted) {
      if (c === '"') {
        if (text[i + 1] === '"') { cur += '"'; i++; }
        else { quoted = false; afterQuote = true; }
      } else cur += c;
      continue;
    }
    if (afterQuote) {
      if (c === ',') { row.push(cur.trim()); cur = ''; afterQuote = false; }
      else if (c === '\n' || c === '\r') {
        if (c === '\r' && text[i + 1] === '\n') i++;
        row.push(cur.trim()); cur = ''; afterQuote = false;
        if (row.some(function(x) { return x !== ''; })) rows.push(row);
        row = [];
      } else if (c === ' ' || c === '\t') { /* allow whitespace after a closing quote */ }
      else throw new Error('Malformed CSV: unexpected character after closing quote at character ' + (i + 1));
      continue;
    }
    if (c === '"') {
      if (cur.trim() !== '') throw new Error('Malformed CSV: quote inside an unquoted field at character ' + (i + 1));
      cur = ''; quoted = true;
    } else if (c === ',') { row.push(cur.trim()); cur = ''; }
    else if (c === '\n' || c === '\r') {
      if (c === '\r' && text[i + 1] === '\n') i++;
      row.push(cur.trim()); cur = '';
      if (row.some(function(x) { return x !== ''; })) rows.push(row);
      row = [];
    } else cur += c;
  }
  if (quoted) throw new Error('Malformed CSV: unclosed quoted field');
  row.push(cur.trim());
  if (row.some(function(x) { return x !== ''; })) rows.push(row);
  return rows;
}

// Split a multi-day CSV: returns the latest day's CSV text and the other days' texts (keyed by ISO date)
function splitCsvByDay(text){
  const arr = parseCSV(text);
  if (arr.length < 2) return { latest: text, others: {}, latestKey: '', warning: '' };
  const normHeader = function(v){ return String(v||'').replace(/^\uFEFF/,'').toLowerCase().replace(/[^a-z0-9]/g,''); };
  const hdr = arr[0].map(normHeader);
  let ci = hdr.indexOf('creationdate');
  if (ci < 0) ci = hdr.indexOf('createddate');
  if (ci < 0) ci = hdr.indexOf('createdat');
  if (ci < 0) ci = hdr.indexOf('orderdate');
  if (ci < 0) return { latest: text, others: {}, latestKey: '', warning: 'Creation Date / Created At / Order Date column nahi mila; day-wise history split skip kiya.' };
  const dateKey = function(value){
    const v = String(value||'').trim();
    let m = v.match(/^(\d{4})-(\d{1,2})-(\d{1,2})(?:\b|T|\s)/);
    if (m) return m[1]+'-'+String(m[2]).padStart(2,'0')+'-'+String(m[3]).padStart(2,'0');
    m = v.match(/^(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})(?:\b|\s|$)/);
    if (m) return m[3]+'-'+String(m[2]).padStart(2,'0')+'-'+String(m[1]).padStart(2,'0');
    return '';
  };
  const groups = {}, unknown = [];
  arr.slice(1).forEach(function(r){
    const k = dateKey(r[ci]);
    if (!k) { unknown.push(r); return; }
    (groups[k] = groups[k] || []).push(r);
  });
  const keys = Object.keys(groups).sort();
  if (keys.length <= 1) {
    if (unknown.length && keys.length) return { latest: text, others: {}, latestKey: keys[0], warning: 'Kuch rows ki Creation Date blank/unknown hai. Galat daily totals se bachne ke liye import rok diya gaya; blank dates correct karke dobara upload karein.', unsafe: true };
    if (unknown.length) return { latest: text, others: {}, latestKey: '', warning: 'Creation Date values pehchani nahi gayi; day-wise history split skip kiya.' };
    return { latest: text, others: {}, latestKey: keys[0] || '', warning: '' };
  }
  // Mixed/blank dates make day attribution uncertain. Never combine multiple days into one report.
  if (unknown.length) return { latest: text, others: {}, latestKey: keys[keys.length-1], warning: 'Multiple dates aur blank/unknown Creation Date rows mili. Galat daily totals se bachne ke liye import rok diya gaya; blank dates correct karke dobara upload karein.', unsafe: true };
  const toCsv = function(rowsArr){
    return [arr[0]].concat(rowsArr).map(function(r){
      return r.map(function(v){ v = String(v == null ? '' : v); return /[",\n\r]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v; }).join(',');
    }).join('\n');
  };
  const latestKey = keys[keys.length - 1];
  const others = {};
  keys.slice(0, -1).forEach(function(k){ others[k] = toCsv(groups[k]); });
  return { latest: toCsv(groups[latestKey]), others: others, latestKey: latestKey, warning: '' };
}
