      return '<tr><td>' + reason + '</td><td style="text-align:center;font-weight:700;">' + c + '</td><td style="text-align:center;">' + (c/totalN*100).toFixed(0) + '%</td><td style="font-size:12px;color:var(--text-muted);">' + top + '</td></tr>';
