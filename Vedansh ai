/* ---------- 2. Trend line charts ---------- */
function lineSvg(labels,vals,color,isPct){
  var W=520,H=210,pl=44,pr=16,pt=18,pb=32,n=vals.length;
  var mx=Math.max.apply(null,vals), mn=Math.min.apply(null,vals);
  if(isPct){mn=Math.floor(mn/10)*10;mx=Math.ceil(mx/10)*10;if(mx<=mn)mx=mn+10;}
  else{mn=0;mx=Math.ceil(mx*1.15);if(mx<=0)mx=1;}
  var iw=W-pl-pr, ih=H-pt-pb;
  function X(i){return pl+(n===1?iw/2:i*iw/(n-1));}
  function Y(v){return pt+ih*(1-(v-mn)/(mx-mn));}
  var s='<svg viewBox="0 0 '+W+' '+H+'" width="100%" role="img" style="display:block">';
  for(var g=0;g<=4;g++){
    var gv=mn+(mx-mn)*g/4, gy=Y(gv);
    s+='<line x1="'+pl+'" y1="'+gy+'" x2="'+(W-pr)+'" y2="'+gy+'" stroke="#2d3b55" stroke-width="1"/>'+
       '<text x="'+(pl-6)+'" y="'+(gy+4)+'" text-anchor="end" font-size="11" fill="#94a3b8">'+Math.round(gv)+(isPct?'%':'')+'</text>';
  }
  var pts=vals.map(function(v,i){return X(i).toFixed(1)+','+Y(v).toFixed(1);}).join(' ');
  if(n>1)s+='<polyline points="'+pts+'" fill="none" stroke="'+color+'" stroke-width="2.5" stroke-linejoin="round"/>';
  var every=Math.ceil(n/7);
  vals.forEach(function(v,i){
    s+='<circle cx="'+X(i)+'" cy="'+Y(v)+'" r="3.5" fill="'+color+'"/>';
    if(n<=10||i===n-1||i%every===0)s+='<text x="'+X(i)+'" y="'+(Y(v)-8)+'" text-anchor="middle" font-size="10" fill="#e2e8f0">'+Math.round(v)+'</text>';
    if(i%every===0||i===n-1)s+='<text x="'+X(i)+'" y="'+(H-10)+'" text-anchor="middle" font-size="10" fill="#94a3b8">'+labels[i]+'</text>';
  });
