function initOfficialRiderRoster(){
 const hs=document.getElementById('rosterHubFilter'),vs=document.getElementById('rosterVendorFilter'); if(!hs||!vs)return;
 [...new Set(OFFICIAL_RIDER_ROSTER.map(r=>r.hub))].sort((a,b)=>a.localeCompare(b)).forEach(v=>hs.add(new Option(v,v)));
 [...new Set(OFFICIAL_RIDER_ROSTER.map(r=>r.vendor))].sort((a,b)=>a.localeCompare(b)).forEach(v=>vs.add(new Option(v,v)));
